{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens AEGIS. Сгенерировано из design/secure-messenger-ui-kit.html — не редактировать вручную.",
  "color": {
    "bg": {
      "base": "#0F1629",
      "raised": "#151D34",
      "card": "#1B2442",
      "hover": "#242F52"
    },
    "line": "#2E3A5C",
    "text": {
      "primary": "#F2F4FC",
      "secondary": "#B4BCD6",
      "muted": "#8E99B8",
      "disabled": "#5A6585"
    },
    "accent": {
      "base": "#8FA5FF",
      "hover": "#A8B9FF",
      "pressed": "#7890F5",
      "on": "#0A1030",
      "dim": "rgba(143,165,255,.14)",
      "line": "rgba(143,165,255,.40)"
    },
    "status": {
      "success": "#3DD598",
      "warning": "#F0B84C",
      "error": "#FF6B78",
      "info": "#8FA5FF",
      "successDim": "rgba(61,213,152,.13)",
      "warningDim": "rgba(240,184,76,.13)",
      "errorDim": "rgba(255,107,120,.13)"
    }
  },
  "radius": {
    "input": 12,
    "button": 14,
    "card": 16,
    "sheet": 24
  },
  "space": [
    4,
    8,
    16,
    24,
    32,
    40,
    48,
    64
  ],
  "motion": {
    "fast": 150,
    "base": 200,
    "slow": 250,
    "ease": "cubic-bezier(0, 0, .2, 1)"
  },
  "size": {
    "buttonSmall": 40,
    "buttonMedium": 48,
    "buttonLarge": 56,
    "input": 48,
    "listRowMin": 64,
    "listRowMax": 72,
    "avatar": [
      40,
      48,
      64,
      88
    ],
    "icon": [
      16,
      20,
      24,
      32
    ],
    "touchTarget": 48,
    "screenMargin": 16
  },
  "typography": {
    "display": {
      "size": 32,
      "lineHeight": 40,
      "weight": 700
    },
    "h1": {
      "size": 28,
      "lineHeight": 36,
      "weight": 700
    },
    "h2": {
      "size": 24,
      "lineHeight": 32,
      "weight": 600
    },
    "h3": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "h4": {
      "size": 17,
      "lineHeight": 24,
      "weight": 600
    },
    "body": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "caption": {
      "size": 13,
      "lineHeight": 18,
      "weight": 400
    },
    "button": {
      "size": 15,
      "lineHeight": 16,
      "weight": 600
    },
    "label": {
      "size": 12,
      "lineHeight": 16,
      "weight": 600
    }
  }
}
