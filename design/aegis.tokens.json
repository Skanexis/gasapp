{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens AEGIS. Сгенерировано из design/secure-messenger-ui-kit.html — не редактировать вручную.",
  "color": {
    "bg": {
      "base": "#0D0F12",
      "raised": "#15181D",
      "card": "#1C2128",
      "hover": "#252B33"
    },
    "line": "#2E353E",
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#B9C1CC",
      "muted": "#7C8796",
      "disabled": "#596170"
    },
    "accent": {
      "base": "#37B8FF",
      "hover": "#5CC6FF",
      "pressed": "#2AA3E8",
      "on": "#06121B",
      "dim": "rgba(55,184,255,.12)",
      "line": "rgba(55,184,255,.38)"
    },
    "status": {
      "success": "#18C37A",
      "warning": "#E4B545",
      "error": "#E5484D",
      "info": "#37B8FF",
      "successDim": "rgba(24,195,122,.12)",
      "warningDim": "rgba(228,181,69,.12)",
      "errorDim": "rgba(229,72,77,.12)"
    }
  },
  "radius": {
    "input": 12,
    "button": 14,
    "card": 16,
    "sheet": 24
  },
  "space": [
    4,
    8,
    16,
    24,
    32,
    40,
    48,
    64
  ],
  "motion": {
    "fast": 150,
    "base": 200,
    "slow": 250,
    "ease": "cubic-bezier(0, 0, .2, 1)"
  },
  "size": {
    "buttonSmall": 40,
    "buttonMedium": 48,
    "buttonLarge": 56,
    "input": 48,
    "listRowMin": 64,
    "listRowMax": 72,
    "avatar": [
      40,
      48,
      64,
      88
    ],
    "icon": [
      16,
      20,
      24,
      32
    ],
    "touchTarget": 48,
    "screenMargin": 16
  },
  "typography": {
    "display": {
      "size": 32,
      "lineHeight": 40,
      "weight": 700
    },
    "h1": {
      "size": 28,
      "lineHeight": 36,
      "weight": 700
    },
    "h2": {
      "size": 24,
      "lineHeight": 32,
      "weight": 600
    },
    "h3": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "h4": {
      "size": 17,
      "lineHeight": 24,
      "weight": 600
    },
    "body": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "caption": {
      "size": 13,
      "lineHeight": 18,
      "weight": 400
    },
    "button": {
      "size": 15,
      "lineHeight": 16,
      "weight": 600
    },
    "label": {
      "size": 12,
      "lineHeight": 16,
      "weight": 600
    }
  }
}
