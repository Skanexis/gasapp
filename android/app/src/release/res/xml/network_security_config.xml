<!--
  Сетевая политика РЕЛИЗНОЙ сборки (ADR-014, раздел 14.3, MASVS NETWORK-2).

  # Почему файл появился только сейчас

  Комментарий в `src/main/res/xml/network_security_config.xml` утверждал,
  что «релизная конфигурация лежит в варианте release и таких исключений
  не содержит». Варианта release не существовало. То есть релизный APK
  собирался с конфигурацией main, а в ней:

    * самоподписанный `@raw/aegis_local_ca` объявлен доверенным корнем
      для 192.168.1.15 и 10.0.2.2;
    * оба пина сняты с ключа локального тестового сервера.

  Первое — дыра, которую нельзя увидеть в диффе: доверие к отладочному
  CA у любого, кто сумеет посадить пользователя в сеть с этими адресами
  (10.0.2.2 — адрес хоста в эмуляторе, 192.168.1.15 — частая частная
  подсеть). Второе — отказ: пины боевого сервера не совпали бы с
  тестовыми, и релиз не смог бы соединиться ни с чем.

  Этот файл перекрывает main целиком по имени ресурса: механизм вариантов
  Gradle берёт версию release, если она есть.
-->
<network-security-config>

    <!--
      Без cleartext и без пользовательских корней.

      🔐 `src="user"` отсутствует намеренно и является главным содержанием
      файла: сертификат, установленный в профиль устройства, — штатный
      способ перехвата в корпоративных и государственных сетях, и
      единственный, который доступен без root. Именно его отвергает тест
      `mitm_proxy_rejected`.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Пиннинг боевого домена.

      ⚠️ ЗАГЛУШКА ДО ПЕРВОГО БОЕВОГО РАЗВЁРТЫВАНИЯ. Значения ниже — не
      пины, а заведомо невозможные константы, и сборка с ними
      соединиться не сможет. Так задумано: отказ заметен на первом же
      запуске, тогда как выдуманный «пока временный» пин выглядит
      рабочей настройкой и доживает до релиза.

      Два значения при этом **разные**, а не одинаковые: правило двух
      пинов проверяется структурно (`MitmProxyRejectedTest`), и заглушка
      не должна учить нарушать его форму. Замена обоих — шаг «Релиз N»
      процедуры docs/ops/cert-pin-rotation.md.

      Процедура замены и ротации — docs/ops/cert-pin-rotation.md.
      Правило двух пинов (раздел 14.3): текущий ключ и заранее выпущенный
      запасной, **разные**. Один пин выглядит рабочим ровно до ротации,
      после которой клиент теряет доверие к серверу и не может получить
      ни нового пина, ни сообщения об ошибке — чинится только обновлением
      через магазин.

      expiration заставляет пиннинг «протухнуть», а не оборвать связь
      навсегда, если про ротацию забыли: после этой даты остаётся обычная
      проверка цепочки до системного корня.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">aegis.chat</domain>

        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>

</network-security-config>
