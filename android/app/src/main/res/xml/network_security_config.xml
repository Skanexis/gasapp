<!--
  Платформенная часть пиннинга (ADR-014, раздел 14.3 плана).

  Проверку ведёт системный TLS-стек, а не приложение. Свой TLS-стек
  внутри клиента обошёл бы настройки платформы — то есть отключил бы
  и пиннинг, и системные отзывы сертификатов. Логика набора пинов
  живёт в crates/aegis-net/src/pinning.rs и проверяется тестами
  без сети; здесь — её включение на Android.
-->
<network-security-config>

    <!--
      cleartextTrafficPermitted="false" на весь трафик приложения.

      Без этого запрета единственный HTTP-запрос (аналитика, картинка,
      редирект) выдал бы факт использования AEGIS наблюдателю канала.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!--
              Только системные корни. Пользовательские (user) намеренно
              исключены: сертификат, установленный в профиль устройства
              — штатный способ MITM в корпоративных и государственных
              сетях, и доверять ему мессенджеру нельзя.
            -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Локальный сервер для проверки на двух устройствах.

      Самоподписанный сертификат добавлен в доверенные **только**
      для этих адресов и только в отладочной сборке: релизная
      конфигурация лежит в res/xml/network_security_config.xml
      варианта release и таких исключений не содержит.

      Пин снят с настоящего сертификата (deploy/tls/cert.pem), а не
      выдуман: подставленный «на будущее» пин не проверяет ничего,
      потому что не совпадает ни с одним живым ключом.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.168.1.15</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>

        <trust-anchors>
            <certificates src="@raw/aegis_local_ca" />
        </trust-anchors>

        <!--
          Два пина: текущий ключ и запасной.

          Набор из одного пина выглядит рабочим ровно до ротации ключа,
          после которой клиент теряет доверие к серверу и не может
          получить ни новый пин, ни сообщение об ошибке — чинится
          только обновлением через магазин.

          expiration заставляет пиннинг «протухнуть», а не оборвать
          связь навсегда, если про ротацию забыли: после этой даты
          проверка отключается и остаётся обычная валидация.
        -->
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">1IopcXdG/uIBY5vwxQZGJHsunMzOiXtU1NraZEmDv+4=</pin>
            <!--
              Запасной пин пока совпадает с основным: второй ключ ещё
              не выпущен. Перед первым боевым развёртыванием сюда
              обязан попасть отдельный ключ, иначе правило двух пинов
              не выполняется по существу.
            -->
            <pin digest="SHA-256">1IopcXdG/uIBY5vwxQZGJHsunMzOiXtU1NraZEmDv+4=</pin>
        </pin-set>
    </domain-config>

</network-security-config>
