<!--
  Нижняя панель: фон raised, скругление 24 только сверху.
  Метрики из UI kit (.sheet).

  Снизу углов нет намеренно: панель приклеена к краю экрана, и
  скругление там оставило бы полоску фона под ней.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_raised" />
    <stroke android:width="1dp" android:color="@color/line" />
    <corners
        android:topLeftRadius="@dimen/radius_sheet"
        android:topRightRadius="@dimen/radius_sheet" />
</shape>
