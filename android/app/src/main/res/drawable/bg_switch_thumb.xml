<!--
  Ползунок переключателя (UI kit, Selection controls): круг 22dp
  с отступом 3dp внутри дорожки 28dp.

  Включён — белый на акцентной дорожке, выключен — светло-серый
  на тёмной. Прежде ползунок был вровень с краями дорожки и тёмным
  во включённом состоянии: читался как тёмное пятно, а не как ручка.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <inset android:inset="3dp">
            <shape android:shape="oval">
                <solid android:color="#FFFFFFFF" />
                <size android:width="22dp" android:height="22dp" />
            </shape>
        </inset>
    </item>

    <item>
        <inset android:inset="3dp">
            <shape android:shape="oval">
                <solid android:color="@color/text_secondary" />
                <size android:width="22dp" android:height="22dp" />
            </shape>
        </inset>
    </item>

</selector>
