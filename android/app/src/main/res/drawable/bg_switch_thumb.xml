<!--
  Ползунок переключателя: круг 22dp.

  Во включённом состоянии — цвет подложки акцента, в выключенном —
  приглушённый текст. Так ползунок читается на обеих дорожках.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_on" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/text_muted" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>

</selector>
