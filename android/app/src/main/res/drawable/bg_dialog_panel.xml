<!--
  Карточка диалога AegisDialog: поверхность card, рамка line, r16.
  Без отступа вокруг, в отличие от bg_dialog: ширину окна
  AegisDialog задаёт сам (не шире 340dp по UI kit).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke android:width="1dp" android:color="@color/line" />
    <corners android:radius="@dimen/radius_card" />
</shape>
