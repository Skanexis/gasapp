<!--
  Поле с подтверждённым значением: зелёная рамка.

  🔐 Ставится только там, где проверка действительно произошла —
  например, имя свободно и подтверждено сервером. Зелёный «просто так»
  приучает не замечать его там, где он означает проверку.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke android:width="1dp" android:color="@color/status_ok" />
    <corners android:radius="@dimen/radius_input" />
</shape>
