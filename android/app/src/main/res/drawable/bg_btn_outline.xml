<!--
  Действие, равное по весу отказу: контур вместо заливки.

  Порядок важен: селектор берёт первое совпадение, поэтому
  исключающие состояния идут раньше общих. disabled первым —
  недоступная кнопка не должна выглядеть нажатой.
-->
<!-- Загрузка — первой: кнопка выглядит обычной и показывает спиннер (UI kit, .b-pri .spin), а не погасшей. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item app:state_loading="true" android:drawable="@drawable/btn_out_normal" />
    <item android:state_enabled="false" android:drawable="@drawable/btn_disabled_bordered" />
    <item android:state_pressed="true" android:drawable="@drawable/btn_out_hovered" />
    <item android:state_focused="true" android:drawable="@drawable/btn_out_hovered" />
    <item android:state_hovered="true" android:drawable="@drawable/btn_out_hovered" />
    <item android:drawable="@drawable/btn_out_normal" />

</selector>
