<!--
  Точка присутствия на аватаре.

  Обводка цветом фона, а не прозрачная: точка ложится на край аватара,
  и без неё сливалась бы с ним.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/status_ok" />
    <stroke
        android:width="2.5dp"
        android:color="@color/bg_base" />
    <size
        android:width="13dp"
        android:height="13dp" />
</shape>
