<!--
  Основное действие экрана. Одна на экран: две кнопки
  равного веса заставляют выбирать вместо того, чтобы
  подсказывать.

  Порядок важен: селектор берёт первое совпадение, поэтому
  исключающие состояния идут раньше общих. disabled первым —
  недоступная кнопка не должна выглядеть нажатой.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item android:state_enabled="false" android:drawable="@drawable/btn_disabled" />
    <item app:state_loading="true" android:drawable="@drawable/btn_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/btn_pri_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/btn_pri_hovered" />
    <item android:state_hovered="true" android:drawable="@drawable/btn_pri_hovered" />
    <item android:drawable="@drawable/btn_pri_normal" />

</selector>
