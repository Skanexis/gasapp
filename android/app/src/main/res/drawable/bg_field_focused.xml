<!--
  Поле в фокусе (UI kit, Inputs: .inp.fc): акцентная рамка и мягкое
  кольцо accent.dim. Единственное поле на экране, которое так
  выглядит, — то, куда идёт ввод.

  В kit кольцо 4px лежит снаружи рамки (box-shadow). Снаружи его
  не нарисовать, не уменьшив остальные состояния поля на те же 4dp,
  поэтому оно здесь внутри рамки: размер поля не прыгает при фокусе,
  а рамка и кольцо читаются так же.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="4dp" android:color="@color/accent_dim" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/accent_base" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
</layer-list>
