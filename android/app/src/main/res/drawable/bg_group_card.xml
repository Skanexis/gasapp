<!--
  Карточка группы строк (UI kit, Settings): card, рамка line, r16.
  Нажатие — подсветка hover поверх, внутри скругления.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bg_hover">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</ripple>
