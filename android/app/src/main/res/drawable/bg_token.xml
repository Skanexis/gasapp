<!--
  Золотой жетон: круг-грань с тёмной кромкой снизу (4dp) — тот же приём,
  что у основной кнопки. Держит значок раздела на пустых экранах.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_edge" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="@dimen/button_edge">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_base" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
