<!--
  Круглая кнопка отправки (.send в UI kit). Недоступная — цвета карточки:
  отправка закрыта (ключ не подтверждён), и кнопка не зовёт нажать.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/bg_card" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_base" />
        </shape>
    </item>
</selector>
