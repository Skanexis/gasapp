<!--
  Поле в покое: рамка цвета линии.

  Прежде здесь стояла акцентная рамка — поле выглядело так, будто
  в нём уже стоит курсор, и подсветка фокуса переставала что-либо
  значить.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke android:width="1dp" android:color="@color/line" />
    <corners android:radius="@dimen/radius_input" />
</shape>
