<!--
  Прикладные состояния компонентов, о которых платформа не знает.
  Подмешиваются во View.onCreateDrawableState и обрабатываются
  селекторами в res/drawable.
-->
<resources>
    <attr name="state_loading" format="boolean" />
    <attr name="state_error" format="boolean" />

    <!--
      Вариант кнопки из UI kit.

      Атрибутом, а не отдельным стилем на каждый случай: вариант
      задаётся в раскладке рядом с текстом кнопки, и видно, какое
      действие какого веса, не открывая values.
    -->
    <declare-styleable name="GasAppButton">
        <attr name="buttonVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="outline" value="2" />
            <enum name="ghost" value="3" />
            <enum name="danger" value="4" />
            <enum name="ok" value="5" />
        </attr>
        <attr name="buttonSize" format="enum">
            <enum name="medium" value="0" />
            <enum name="large" value="1" />
            <enum name="small" value="2" />
        </attr>
    </declare-styleable>

    <!--
      Значок в поле ввода (UI kit, Inputs: иконки 20dp приглушённым
      цветом) — например, лупа в поле поиска.
    -->
    <declare-styleable name="GasAppTextField">
        <attr name="fieldIcon" format="reference" />
    </declare-styleable>

    <!-- Ночная сцена (components/NightSceneView). -->
    <declare-styleable name="NightSceneView">
        <!-- Рисовать луну. -->
        <attr name="sceneMoon" format="boolean" />
        <!-- Рисовать ельник и поляну; без них — только небо. -->
        <attr name="sceneForest" format="boolean" />
        <!-- Растворять низ сцены в фоне экрана. -->
        <attr name="sceneFade" format="boolean" />
        <!-- Скругление углов сцены-карточки. -->
        <attr name="sceneRadius" format="dimension" />
    </declare-styleable>

    <!-- Логотип объёмными буквами (components/WordmarkView). -->
    <declare-styleable name="WordmarkView">
        <attr name="wordmarkSize" format="dimension" />
        <attr name="wordmarkText" format="string" />
    </declare-styleable>
</resources>

