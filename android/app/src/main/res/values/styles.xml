<!--
  Стили компонентов из UI kit.

  Вынесены в стили, а не повторены в каждой раскладке: четыре вкладки
  навигации отличаются только иконкой и подписью, и правка отступа
  в одном месте из четырёх — самый частый способ развалить сетку.
-->
<resources>

    <!-- Вкладка нижней навигации -->
    <style name="GasAppNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Подпись вкладки: 10sp по макету -->
    <style name="GasAppNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <!-- Третичный, не «отключённый»: неактивная вкладка — работающая
             кнопка, и её подпись обязана читаться (≥ 4,5:1). -->
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Заголовок экрана -->
    <style name="GasAppAppBarTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!--
      Крупный заголовок корневых вкладок (Чаты, Звонки, Контакты): H1,
      как в kit у заголовков экранов верхнего уровня. Вложенные экраны
      со стрелкой «назад» остаются с обычным.
    -->
    <style name="GasAppAppBarTitle.Large">
        <item name="android:textSize">@dimen/text_h1</item>
        <!-- Заголовок раздела — шрифтом вывески (DESIGN.md, «Night Camp»). -->
        <item name="android:fontFamily">@font/rubik</item>
        <item name="fontFamily">@font/rubik</item>
        <item name="android:textFontWeight">900</item>
        <item name="android:textStyle">normal</item>
        <item name="android:accessibilityHeading">true</item>
        <!-- Строка 48dp: с кнопками и без заголовок на одной высоте. -->
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">center_vertical</item>
    </style>


    <!-- Точка PIN: 14dp, промежуток 14dp по макету -->
    <style name="GasAppPinDot">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/bg_pin_dot</item>
    </style>

    <!-- Клавиша цифровой клавиатуры -->
    <style name="GasAppKeypadKey">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_keypad_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">26sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
      Стиль диалогов.
      
      Задаётся явно: без него AlertDialog берёт светлую тему платформы
      и появляется белым окном поверх тёмного приложения.
    -->
    <style name="GasAppDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent_base</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/GasAppDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/GasAppDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/GasAppDialogButton</item>
        <item name="android:textAppearanceMedium">@style/GasAppText.Body</item>
    </style>

    <!--
      Кнопка диалога.

      Текст акцентом и без капитализации — как в остальном приложении.
      Заглавные буквы, которые платформа ставит по умолчанию,
      выглядят чужеродно рядом с кнопками GasApp.
    -->
    <style name="GasAppDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/accent_base</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      Окно GasAppDialog: без системной рамки и заголовка — карточку
      рисует разметка view_dialog. Затемнение фона — как у системного
      диалога.
    -->
    <style name="GasAppDialogWindow" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="colorAccent">@color/accent_base</item>
        <item name="colorPrimary">@color/accent_base</item>
        <item name="editTextStyle">@style/Widget.GasApp.EditText</item>
        <item name="android:editTextStyle">@style/Widget.GasApp.EditText</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!--
      Окно нижней панели.

      Прозрачный фон и отсутствие анимации окна: панель рисует себя
      сама, а системная рамка добавила бы вокруг неё лишний слой.
    -->
    <style name="GasAppSheetDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/GasAppSheetAnimation</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!--
      Появление панели: выезд снизу.

      200 мс — базовая длительность из токенов. Быстрее выглядит
      рывком, медленнее — задержкой перед действием.
    -->
    <style name="GasAppSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
