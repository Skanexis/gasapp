<!--
  Стили компонентов из UI kit.

  Вынесены в стили, а не повторены в каждой раскладке: четыре вкладки
  навигации отличаются только иконкой и подписью, и правка отступа
  в одном месте из четырёх — самый частый способ развалить сетку.
-->
<resources>

    <!-- Вкладка нижней навигации -->
    <style name="AegisNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Подпись вкладки: 10sp по макету -->
    <style name="AegisNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_quaternary</item>
    </style>

    <!-- Заголовок экрана -->
    <style name="AegisAppBarTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>


    <!-- Точка PIN: 14dp, промежуток 14dp по макету -->
    <style name="AegisPinDot">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/bg_pin_dot</item>
    </style>

    <!-- Клавиша цифровой клавиатуры -->
    <style name="AegisKeypadKey">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_keypad_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
      Стиль диалогов.
      
      Задаётся явно: без него AlertDialog берёт светлую тему платформы
      и появляется белым окном поверх тёмного приложения.
    -->
    <style name="AegisDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent_base</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/AegisDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AegisDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AegisDialogButton</item>
        <item name="android:textAppearanceMedium">@style/AegisText.Body</item>
    </style>

    <!--
      Кнопка диалога.

      Текст акцентом и без капитализации — как в остальном приложении.
      Заглавные буквы, которые платформа ставит по умолчанию,
      выглядят чужеродно рядом с кнопками AEGIS.
    -->
    <style name="AegisDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/accent_base</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      Окно AegisDialog: без системной рамки и заголовка — карточку
      рисует разметка view_dialog. Затемнение фона — как у системного
      диалога.
    -->
    <style name="AegisDialogWindow" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="colorAccent">@color/accent_base</item>
        <item name="colorPrimary">@color/accent_base</item>
        <item name="editTextStyle">@style/Widget.Aegis.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Aegis.EditText</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!--
      Окно нижней панели.

      Прозрачный фон и отсутствие анимации окна: панель рисует себя
      сама, а системная рамка добавила бы вокруг неё лишний слой.
    -->
    <style name="AegisSheetDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/AegisSheetAnimation</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!--
      Появление панели: выезд снизу.

      200 мс — базовая длительность из токенов. Быстрее выглядит
      рывком, медленнее — задержкой перед действием.
    -->
    <style name="AegisSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
