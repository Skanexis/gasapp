<!--
  Компоненты дизайн-системы из design/secure-messenger-ui-kit.html.

  Каждый стиль повторяет метрики макета: высоту, отступы, скругление,
  шрифт. Раскладки ссылаются на стиль, а не задают эти числа сами —
  иначе один и тот же элемент на двух экранах разъезжается при первой
  же правке.
-->
<resources>

    <!-- ============ Кнопки ============ -->

    <!--
      Базовая кнопка: 48dp, отступы 24, радиус 14, шрифт 600/15.
      Метрики из UI kit (.btn).
    -->
    <style name="AegisButton">
        <item name="android:layout_height">@dimen/button_medium</item>
        <item name="android:minHeight">@dimen/button_medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Основное действие экрана. -->
    <style name="AegisButton.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/button_text_on_accent</item>
    </style>

    <!-- Второстепенное действие рядом с основным. -->
    <style name="AegisButton.Secondary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/button_text_default</item>
    </style>

    <!-- Действие, равное по весу отказу. -->
    <style name="AegisButton.Outline">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/button_text_default</item>
    </style>

    <!-- Действие в ряду других: заливка только под нажатием. -->
    <style name="AegisButton.Ghost">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/button_text_accent</item>
    </style>

    <!--
      🔐 Необратимое действие: удалить переписку, сбросить ключи.
      Вес 700, а не 600 — на шаг, который нельзя отменить, смотрят
      дольше.
    -->
    <style name="AegisButton.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/button_text_on_danger</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- 🔐 Подтверждение проверки: сверка прошла. -->
    <style name="AegisButton.Ok">
        <item name="android:background">@drawable/bg_btn_ok</item>
        <item name="android:textColor">@color/button_text_on_ok</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Крупная кнопка: 56dp, отступы 32, кегль 16, радиус 16. -->
    <style name="AegisButton.Large">
        <item name="android:layout_height">@dimen/button_large</item>
        <item name="android:minHeight">@dimen/button_large</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Малая кнопка: 40dp, отступы 16, кегль 14, радиус 12. -->
    <style name="AegisButton.Small">
        <item name="android:layout_height">@dimen/button_small</item>
        <item name="android:minHeight">@dimen/button_small</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ============ Поля ввода ============ -->

    <!--
      Поле: 48dp, отступы 16, радиус 12, шрифт 400/15.
      Метрики из UI kit (.inp).
    -->
    <style name="AegisInput">
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_aegis_text_field</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!--
      Поле ввода по умолчанию — для каждого EditText приложения через тему.

      Прежде фон поля задавался в коде без отступов, и текст прилипал
      к рамке: подсказка «username» начиналась прямо с края, а поле
      сообщения было ниже и крупнее, чем в макете. Отступы, высота,
      кегль и цвета — метрики .inp из UI kit.
    -->
    <style name="Widget.Aegis.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_aegis_text_field</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Сегмент переключателя (.seg в UI kit): равные доли, выбранный — подложкой. -->
    <style name="AegisSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ============ Карточки ============ -->

    <style name="AegisCard">
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <!-- ============ Панель ============ -->

    <!--
      Панель: фон raised, рамка line, радиус 16, паддинг 24.
      Метрики из UI kit (.panel).

      Панель группирует связанное. Без рамки и отступа настройки
      сливаются в один длинный список, где непонятно, что к чему
      относится.
    -->
    <style name="AegisPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:orientation">vertical</item>
        <!-- 16dp, как у карточки .card в UI kit: строки внутри дают свои 8dp сверху и снизу. -->
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <!--
      Группа строк (UI kit, Settings: grouped list): карточка r16 без
      внутренних отступов — строки дают свои. Обрезку по скруглению
      и разделители строк ставит класс AegisGroup.
    -->
    <style name="AegisGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_group_card</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!--
      Крупный заголовок корневых экранов (Чаты, Звонки, Контакты,
      Настройки): H1 28/36, как «Security Center» в kit.
    -->
    <style name="AegisLargeTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <!--
          Строка 48dp, как в шапках с кнопками, — заголовки всех вкладок
          на одной высоте. minHeight считает и отступы: 16 + 48 + 8.
        -->
        <item name="android:minHeight">72dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!--
      Строка обещания на приветствии: значок акцентом слева, текст Body.
      Значок 20dp, как в строках настроек.
    -->
    <style name="AegisOnboardingFeature">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:drawableTint">@color/accent_base</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <!--
      Свойство копии с галочкой (UI kit, Authentication: «✓ Stored
      nowhere»): значок статуса слева, текст вторичного цвета.
    -->
    <style name="AegisRecoveryFact">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/ic_check_small</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/status_ok</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
      Плитка действия (карточка контакта): значок в круге и подпись
      под ним. Плитки делят ширину поровну — ни одно из двух главных
      действий не выглядит второстепенным.
    -->
    <style name="AegisActionTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:background">@drawable/bg_group_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <style name="AegisActionTileIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:padding">9dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/accent_base</item>
    </style>

    <style name="AegisActionTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!--
      Строка выбора из списка (UI kit, Lists &amp; Selection Controls):
      подпись слева, переключатель-кружок справа, строка 52dp.
    -->
    <style name="AegisRadioRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">?android:attr/listChoiceIndicatorSingle</item>
        <item name="android:drawableTint">@color/accent_base</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Панель на карточном фоне: вложенная группа внутри панели. -->
    <style name="AegisPanel.Deep">
        <item name="android:background">@drawable/bg_panel_deep</item>
    </style>

    <!--
      Метка секции: 600/12, прописные, разрядка 0.1em.
      Метрики из UI kit (.lb).

      Разрядка обязательна: прописные без неё читаются как сплошной
      блок, и заголовок перестаёт отделять секции друг от друга.
    -->
    <style name="AegisSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>

    <!-- Пояснение под заголовком: 13sp вторичного цвета. -->
    <style name="AegisCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <!-- ============ Строки списка ============ -->

    <!--
      Строка списка: минимум 64dp.

      Не только сетка: 64dp вмещает область нажатия в 48dp с полями,
      а промах в списке чатов открывает не ту переписку.
    -->
    <style name="AegisListRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/list_row_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ============ Пилюли состояния ============ -->

    <!--
      Пилюля: 24dp, радиус 12, кегль 11/600 с разрядкой.
      Метрики из UI kit (.pill).

      🔐 Цвет пилюли — это утверждение о безопасности, а не оформление.
      Зелёная означает проверенное человеком, жёлтая — требующее
      внимания, красная — состоявшуюся проблему. Ставить их «для
      красоты» значит обесценить те, что стоят по делу.
    -->
    <style name="AegisPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="AegisPill.Ok">
        <item name="android:background">@drawable/bg_pill_ok</item>
        <item name="android:textColor">@color/status_ok</item>
    </style>

    <style name="AegisPill.Warn">
        <item name="android:background">@drawable/bg_pill_warn</item>
        <item name="android:textColor">@color/status_warn</item>
    </style>

    <style name="AegisPill.Error">
        <item name="android:background">@drawable/bg_pill_error</item>
        <item name="android:textColor">@color/status_error</item>
    </style>

    <style name="AegisPill.Accent">
        <item name="android:background">@drawable/bg_pill_accent</item>
        <item name="android:textColor">@color/accent_base</item>
    </style>

    <style name="AegisPill.Neutral">
        <item name="android:background">@drawable/bg_pill_neutral</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ============ Шапка экрана ============ -->

    <!-- Шапка одного цвета с экраном, как в UI kit (.appbar): полоса
         другого цвета делила экран там, где макет его не делит. -->
    <style name="AegisAppBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:background">@color/bg_base</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- ============ Иконка-кнопка ============ -->

    <!--
      Иконка в шапке или строке ввода.

      Размер значка 24dp, но область нажатия 48dp: меньшая цель
      промахивается, а промах здесь открывает не тот экран.
    -->
    <style name="AegisIconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
