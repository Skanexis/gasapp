<!--
  Тема приложения. Дизайн-система AEGIS тёмная по умолчанию (UI kit),
  поэтому базой взята DayNight с принудительно тёмной палитрой, а не
  светлая тема со «слоем» поверх.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Тема всегда тёмная, а не DayNight.

      Приложение нарисовано под тёмный фон (UI kit), и светлый режим
      системы делал бы диалоги белыми поверх тёмных экранов. Кроме
      того, тёмный интерфейс меньше заметен со стороны — мелочь,
      но в пользу того, ради чего мессенджер существует.
    -->
    <style name="Theme.AEGIS" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_base</item>
        <item name="colorPrimaryVariant">@color/accent_pressed</item>
        <item name="colorOnPrimary">@color/accent_on</item>

        <!--
          Курсор, ручки выделения и выделение текста — акцентом кита.
          Без этого они брали бирюзовый цвет платформы: единственный
          цвет на экране не из палитры.
        -->
        <item name="colorAccent">@color/accent_base</item>
        <item name="colorControlActivated">@color/accent_base</item>
        <item name="android:colorControlActivated">@color/accent_base</item>
        <item name="android:textColorHighlight">@color/accent_line</item>

        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!--
          Inter — шрифт макета. Задаётся в теме, а не в каждом
          TextView: пропущенный атрибут дал бы системный Roboto,
          и экран отличался бы от макета шириной строк, а не только
          рисунком букв.

          android:fontFamily покрывает и виджеты платформы, и AppCompat /
          Material: они читают его, когда своего `fontFamily` нет.

          🔐 Атрибута AppCompat `fontFamily` здесь нет намеренно. С ним
          AppCompat догружал Inter из темы асинхронно и перезаписывал
          шрифт поля уже после того, как экран задал ему свой: safety
          number, ключи и ключ восстановления, объявленные моноширинными,
          на устройстве набирались Inter. Сверка по позициям символов
          при этом не работает (раздел 20.1). См. MonospaceKeysTest.
        -->
        <item name="android:fontFamily">@font/inter</item>

        <!--
          Диалоги: без явного указания AlertDialog берёт светлую тему
          платформы и появляется белым окном поверх тёмного приложения.
        -->
        <item name="android:alertDialogTheme">@style/AegisDialog</item>
        <item name="alertDialogTheme">@style/AegisDialog</item>

        <!-- Поле ввода: отступы, высота и кегль из UI kit (components.xml). -->
        <item name="editTextStyle">@style/Widget.Aegis.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Aegis.EditText</item>

        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>

        <!--
          🔐 Раздел 19.2 плана: содержимое приложения не должно попадать
          в системный снимок экрана переключателя задач. Флаг ставится
          в коде (FLAG_SECURE), здесь фиксируется только тёмный фон,
          чтобы снимок не «мигал» белым до его установки.
        -->
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
