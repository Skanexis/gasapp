<!--
  Палитра из UI kit (design/secure-messenger-ui-kit.html).

  Значения переносятся дословно: расхождение между макетом и сборкой
  проще всего заводится именно здесь, а заметить его на глаз трудно.
-->
<resources>

    <!-- Поверхности -->
    <color name="bg_base">#FF0D0F12</color>
    <color name="bg_raised">#FF15181D</color>
    <color name="bg_card">#FF1C2128</color>
    <color name="bg_hover">#FF252B33</color>
    <color name="line">#FF2E353E</color>

    <!-- Текст: четыре ступени контраста, как в макете -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#FFB9C1CC</color>
    <color name="text_tertiary">#FF7C8796</color>
    <color name="text_quaternary">#FF596170</color>

    <!-- Акцент -->
    <color name="accent_base">#FF37B8FF</color>
    <color name="accent_hover">#FF5CC6FF</color>
    <color name="accent_pressed">#FF2AA3E8</color>
    <color name="accent_on">#FF06121B</color>

    <!--
      Приглушённый акцент для подложек.

      Прозрачность, а не сплошной цвет: подложка ложится поверх разных
      поверхностей, и сплошной вариант пришлось бы заводить для каждой.
    -->
    <color name="accent_dim">#2637B8FF</color>

    <!--
      Пузырь исходящего сообщения.

      Приглушённый синий из макета: сплошной акцент ухудшил бы
      читаемость текста и обесценил сам акцент.
    -->
    <color name="bubble_outgoing">#FF173850</color>

    <!--
      Состояния.

      🔐 Зелёный означает «проверено», красный — «внимание». Эти два
      цвета несут смысл безопасности, поэтому используются только по
      назначению: зелёная галочка у неверифицированного контакта
      обесценила бы верификацию.
    -->
    <color name="status_ok">#FF18C37A</color>
    <color name="status_warn">#FFE4B545</color>
    <color name="status_error">#FFE5484D</color>
    <color name="status_info">#FF37B8FF</color>

    <!-- Приглушённые варианты состояний для подложек -->
    <color name="status_ok_dim">#2618C37A</color>
    <color name="status_warn_dim">#26E4B545</color>
    <color name="status_error_dim">#26E5484D</color>

</resources>
