<!--
  Палитра из UI kit (design/secure-messenger-ui-kit.html).

  Значения переносятся дословно: расхождение между макетом и сборкой
  проще всего заводится именно здесь, а заметить его на глаз трудно.
-->
<resources>

    <!-- Поверхности -->
    <color name="bg_base">#FF0F1629</color>
    <color name="bg_raised">#FF151D34</color>
    <color name="bg_card">#FF1B2442</color>
    <color name="bg_hover">#FF242F52</color>
    <color name="line">#FF2E3A5C</color>

    <!-- Текст: четыре ступени контраста, как в макете -->
    <color name="text_primary">#FFF2F4FC</color>
    <color name="text_secondary">#FFB4BCD6</color>
    <color name="text_tertiary">#FF8E99B8</color>
    <color name="text_quaternary">#FF5A6585</color>

    <!-- Акцент -->
    <!--
      Имена из design/aegis.tokens.json.
      
      Палитра в проекте сложилась раньше токенов и назвала те же цвета
      иначе. Синонимы, а не переименование: правка сотни ссылок
      в раскладках ради имени — риск пропустить одну и получить
      несобираемый ресурс, тогда как значения совпадают до байта.
    -->
    <color name="text_muted">@color/text_tertiary</color>
    <color name="text_disabled">@color/text_quaternary</color>
    <color name="status_success">@color/status_ok</color>
    <color name="status_warning">@color/status_warn</color>
    <color name="accent_line">#668FA5FF</color>

    <color name="accent_base">#FF8FA5FF</color>
    <color name="accent_hover">#FFA8B9FF</color>
    <color name="accent_pressed">#FF7890F5</color>
    <color name="accent_on">#FF0A1030</color>

    <!--
      Приглушённый акцент для подложек.

      Прозрачность, а не сплошной цвет: подложка ложится поверх разных
      поверхностей, и сплошной вариант пришлось бы заводить для каждой.
    -->
    <color name="accent_dim">#248FA5FF</color>

    <!--
      Пузырь исходящего сообщения.

      «Чернила» акцента с тёмным текстом (DESIGN.md, «Ink On Paper»):
      сторона разговора читается без подписи. Текст на нём — 8:1,
      метки — 5:1 (bubble_outgoing_text / _meta).
    -->
    <color name="bubble_outgoing">#FF8FA5FF</color>
    <!-- Текст и метки на «чернилах» исходящего пузыря. -->
    <color name="bubble_outgoing_text">#FF0A1030</color>
    <color name="bubble_outgoing_meta">#C00A1030</color>

    <!--
      Состояния.

      🔐 Зелёный означает «проверено», красный — «внимание». Эти два
      цвета несут смысл безопасности, поэтому используются только по
      назначению: зелёная галочка у неверифицированного контакта
      обесценила бы верификацию.
    -->
    <color name="status_ok">#FF3DD598</color>
    <color name="status_warn">#FFF0B84C</color>
    <color name="status_error">#FFFF6B78</color>
    <color name="status_info">#FF8FA5FF</color>

    <!-- Приглушённые варианты состояний для подложек -->
    <color name="status_ok_dim">#213DD598</color>
    <color name="status_warn_dim">#21F0B84C</color>
    <color name="status_error_dim">#21FF6B78</color>

</resources>
