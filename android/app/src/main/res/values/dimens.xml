<!--
  Размеры из design/gasapp.tokens.json.

  Значения продублированы здесь, а не вычисляются: токены — источник
  истины, но Android не читает JSON во время сборки. Расхождение ловится
  тестом, сверяющим эти ресурсы с файлом токенов.

  Правило: в раскладках используются эти имена, а не числа. Число,
  вписанное прямо в раскладку, переживает любую правку токенов — и
  экран тихо расходится с макетом.
-->
<resources>

    <!-- Шкала отступов: 4 / 8 / 16 / 24 / 32 / 40 / 48 / 64 -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">16dp</dimen>
    <dimen name="space_l">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_2xl">40dp</dimen>
    <dimen name="space_3xl">48dp</dimen>
    <dimen name="space_4xl">64dp</dimen>

    <!-- Скругления -->
    <dimen name="radius_input">12dp</dimen>
    <dimen name="radius_button">14dp</dimen>
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_sheet">24dp</dimen>

    <!-- Высоты элементов -->
    <dimen name="button_small">40dp</dimen>
    <dimen name="button_medium">48dp</dimen>
    <dimen name="button_large">56dp</dimen>
    <!-- Кромка объёмной кнопки и ход её нажатия. -->
    <dimen name="button_edge">4dp</dimen>
    <dimen name="button_edge_pressed">3dp</dimen>
    <dimen name="input_height">48dp</dimen>
    <!-- Диалог: не шире 340dp (UI kit, Dialogs). -->
    <dimen name="dialog_max_width">340dp</dimen>
    <!-- Отступ от значка поля до текста (UI kit, .inp: gap 12). -->
    <dimen name="field_icon_gap">12dp</dimen>
    <!-- Спиннер загрузки в кнопке (UI kit, .spin: 18px, линия 2px). -->
    <dimen name="button_spinner">18dp</dimen>
    <dimen name="button_spinner_stroke">2dp</dimen>
    <!-- Тост: над нижней панелью экрана; текст не шире 300 (карточка ≤ 360, UI kit). -->
    <dimen name="toast_bottom">88dp</dimen>
    <dimen name="toast_text_max">300dp</dimen>
    <dimen name="list_row_min">64dp</dimen>
    <dimen name="list_row_max">72dp</dimen>

    <!--
      Минимальная область нажатия.

      48dp — не украшение: меньшая цель промахивается, а промах
      в мессенджере отправляет сообщение не тому или открывает не тот
      чат.
    -->
    <dimen name="touch_target">48dp</dimen>

    <!-- Аватары: 40 / 48 / 64 / 88 -->
    <dimen name="avatar_s">40dp</dimen>
    <dimen name="avatar_m">48dp</dimen>
    <dimen name="avatar_l">64dp</dimen>
    <dimen name="avatar_xl">88dp</dimen>

    <!-- Иконки: 16 / 20 / 24 / 32 -->
    <dimen name="icon_xs">16dp</dimen>
    <dimen name="icon_s">20dp</dimen>
    <dimen name="icon_m">24dp</dimen>
    <dimen name="icon_l">32dp</dimen>

    <!-- Поля экрана -->
    <dimen name="screen_padding">16dp</dimen>

    <!--
      Прежние имена, оставленные ради существующих раскладок.

      Указывают на значения шкалы, а не на свои собственные: два
      источника размера — верный способ получить два разных отступа
      там, где задуман один.
    -->
    <dimen name="list_row_padding">16dp</dimen>
    <dimen name="chat_row_padding_vertical">12dp</dimen>
    <dimen name="avatar_size">48dp</dimen>
    <dimen name="bubble_max_width">280dp</dimen>

    <!-- Типографика: размеры кегля -->
    <dimen name="text_display">32sp</dimen>
    <dimen name="text_h1">28sp</dimen>
    <dimen name="text_h2">24sp</dimen>
    <dimen name="text_h3">20sp</dimen>
    <dimen name="text_h4">17sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_caption">13sp</dimen>
    <dimen name="text_button">15sp</dimen>
    <dimen name="text_label">12sp</dimen>

    <!-- QR-код ссылки канала в диалоге. -->
    <dimen name="channel_qr">208dp</dimen>
    <!-- Запись канала: высота картинки в ленте, пилюля реакции. -->
    <dimen name="channel_image_height">208dp</dimen>
    <dimen name="channel_reaction_height">28dp</dimen>
    <dimen name="channel_reaction_padding">10dp</dimen>
</resources>
