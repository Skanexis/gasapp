<!--
  Настройки по UI kit: профиль с QR, затем разделы.

  🔐 Раздел «Безопасность» выделен цветом акцента — он ведёт в
  Security Center, где живут проверки, от которых зависит защита
  переписки. Остальные разделы нейтральны.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <TextView
        style="@style/AegisLargeTitle"
        android:text="@string/nav_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
          Сгруппированные карточки (UI kit, Settings: grouped list):
          профиль отдельно, дальше группы по смыслу. Плоский список во
          всю ширину выглядел устаревшим и не делил разделы.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_l">

            <!-- Профиль -->
            <LinearLayout
                android:id="@+id/profile_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <TextView
                        android:id="@+id/profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:textColor="@color/accent_base"
                        android:textSize="20sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        tools:text="MK" />

                    <!--
                      🔐 Значок сверки на **своём** профиле скрыт.

                      В макете он нарисован, но означать здесь ему
                      нечего: сверяют чужой ключ, а не свой, и галочка
                      рядом с собственным именем — утверждение
                      о безопасности, которое никто не делал.

                      Элемент оставлен на месте: он понадобится, когда
                      появится подтверждение аккаунта, и тогда его
                      покажет код, а не разметка.
                    -->
                    <ImageView
                        android:id="@+id/profile_verified"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_verified_badge"
                        android:contentDescription="@string/chat_verified_mark"
                        android:padding="3dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/accent_on"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        tools:text="Maria Keller" />

                    <TextView
                        android:id="@+id/profile_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        tools:text="@maria.k" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/profile_qr"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/show_my_qr"
                    android:src="@drawable/ic_qr"
                    app:tint="@color/accent_base" />
            </LinearLayout>

            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/settings_section_protection" />

            <LinearLayout style="@style/AegisGroup">

                <include
                    android:id="@+id/settings_security"
                    layout="@layout/item_settings_row" />

                <View style="@style/AegisGroupDivider" />

                <include
                    android:id="@+id/settings_privacy"
                    layout="@layout/item_settings_row" />

                <View style="@style/AegisGroupDivider" />

                <include
                    android:id="@+id/settings_notifications"
                    layout="@layout/item_settings_row" />

                <View style="@style/AegisGroupDivider" />

                <include
                    android:id="@+id/settings_devices"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/settings_section_app" />

            <LinearLayout style="@style/AegisGroup">

                <include
                    android:id="@+id/settings_appearance"
                    layout="@layout/item_settings_row" />

                <View style="@style/AegisGroupDivider" />

                <include
                    android:id="@+id/settings_storage"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <!--
              Резервное копирование и хранилище файлов — отдельной
              группой «Данные»: для пользователя это про данные, а не
              про ключи.
            -->
            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/settings_section_data" />

            <LinearLayout style="@style/AegisGroup">

                <include
                    android:id="@+id/settings_recovery"
                    layout="@layout/item_settings_row" />

                <View style="@style/AegisGroupDivider" />

                <include
                    android:id="@+id/settings_vault"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/settings_section_about" />

            <LinearLayout style="@style/AegisGroup">

                <include
                    android:id="@+id/settings_about"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
