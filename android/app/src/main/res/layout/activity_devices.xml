<!--
  Связанные устройства.

  🔐 Каждое связанное устройство читает переписку целиком. Список
  показывает, сколько их и когда каждое выходило на связь: устройство,
  о котором пользователь не помнит, — повод для тревоги, и увидеть его
  он должен без усилий.

  Связывание устройств появится в M7 вместе с протоколом из раздела
  13.2. До тех пор список показывает только текущее устройство —
  честное состояние, а не заглушка.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/AegisAppBar">

        <ImageView
            android:id="@+id/devices_back"
            style="@style/AegisIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/AegisAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_devices" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/AegisSectionLabel"
                android:text="@string/devices_section_current" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/devices_this"
                    layout="@layout/item_settings_row" />
            </org.aegis.app.components.AegisGroup>
            <TextView
                style="@style/AegisCaption"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/devices_note" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
