<!--
  Устройства аккаунта (docs/protocol/MULTI-DEVICE.md).

  🔐 Каждое подключённое устройство читает новую переписку. Список
  показывает, сколько их: устройство, о котором пользователь не помнит, —
  повод для тревоги, и увидеть его он должен без усилий. Подключают и
  отключают только с основного телефона.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/devices_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_devices" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/GasAppText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devices_intro" />

            <TextView
                android:id="@+id/devices_status"
                style="@style/GasAppText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone"
                tools:text="Цифры не совпали — устройство не подключено."
                tools:visibility="visible" />

            <!--
              Грант ушёл: эти цифры должны появиться на новом телефоне.
              Сверяют их там — поэтому здесь они остаются, пока он не войдёт.
            -->
            <LinearLayout
                android:id="@+id/devices_code_panel"
                style="@style/GasAppPanel"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/GasAppText.H4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/devices_code_title" />

                <TextView
                    android:id="@+id/devices_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:fontFamily="@font/rubik"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:textColor="@color/accent_base"
                    android:textSize="40sp"
                    tools:text="482 913" />

                <TextView
                    style="@style/GasAppText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/devices_approved" />
            </LinearLayout>

            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/devices_section_current" />

            <org.gasapp.app.components.GasAppGroup
                android:id="@+id/devices_list"
                style="@style/GasAppGroup" />

            <ProgressBar
                android:id="@+id/devices_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:indeterminateTint="@color/accent_base" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/devices_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/devices_link"
                android:visibility="gone"
                app:buttonVariant="primary"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/devices_link_hint"
                style="@style/GasAppText.Caption.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/devices_link_hint"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                style="@style/GasAppText.Caption.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/devices_note_history" />

            <TextView
                style="@style/GasAppText.Caption.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/devices_note_privacy" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
