<!--
  Экран переписки.

  Раскладка следует UI kit («Complete Mobile Screens» → Message).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Шапка: собеседник и его состояние верификации. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_raised"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        android:paddingVertical="@dimen/space_s">

        <ImageView
            android:id="@+id/chat_back"
            style="@style/AegisIconButton"
            android:padding="12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <!-- Аватар собеседника, 40dp (.av.s в UI kit). -->
        <TextView
            android:id="@+id/chat_avatar"
            android:layout_width="@dimen/avatar_s"
            android:layout_height="@dimen/avatar_s"
            android:background="@drawable/bg_avatar"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="@color/accent_base"
            android:textSize="14sp"
            tools:text="LN" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="Lena Novak" />

            <!--
              🔐 Подпись о состоянии сверки. Открывает экран safety number.
              Показывается всегда, а не только при проблеме: пользователь
              должен видеть, верифицирован ли собеседник, до того как
              напишет что-то важное.
            -->
            <TextView
                android:id="@+id/chat_verification_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="Не верифицирован — сверьте safety number" />
        </LinearLayout>

        <!--
          Меню чата: сверка, таймер исчезновения, присутствие.

          Отдельная кнопка, а не длинное нажатие на заголовок:
          действия над чатом должны быть видимы, а не найдены
          случайно.
        -->
        <ImageView
            android:id="@+id/chat_menu"
            style="@style/AegisIconButton"
            android:contentDescription="@string/chat_menu"
            android:src="@drawable/ic_more"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!--
      🔐 Предупреждение о смене identity-ключа.

      Показывается поверх переписки, а не в углу: когда сервер называет
      для имени другой ключ, ядро отказывается отправлять, пока человек
      не выберет ключ, — и узнать об этом нужно до того, как начнёшь
      печатать. Текст задаёт ChatActivity (SendGuard).
    -->
    <LinearLayout
        android:id="@+id/key_change_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_m"
        android:background="@drawable/bg_notice_warn"
        android:orientation="vertical"
        android:padding="@dimen/space_m"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/key_change_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/key_changed_title"
            android:textColor="@color/status_warn"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/key_change_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4sp"
            android:ellipsize="end"
            android:maxLines="@integer/banner_body_lines"
            tools:text="@string/key_changed_body"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <org.aegis.app.components.AegisButton
            android:id="@+id/key_change_verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/verify_safety_number"
            app:buttonSize="small"
            app:buttonVariant="primary" />

        <!-- Запрос на переписку: «Принять» и «Отклонить». -->
        <LinearLayout
            android:id="@+id/request_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <org.aegis.app.components.AegisButton
                android:id="@+id/request_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/request_accept"
                app:buttonSize="small"
                app:buttonVariant="primary" />

            <org.aegis.app.components.AegisButton
                android:id="@+id/request_decline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/request_decline"
                app:buttonSize="small"
                app:buttonVariant="secondary" />
        </LinearLayout>
    </LinearLayout>

        <!--
          🔐 Чип сквозного шифрования.

          Показывается всегда, а не только при первом открытии чата:
          он сообщает о состоянии защиты, и его исчезновение должно
          означать, что защиты нет. Постоянная надпись, которую нельзя
          убрать, — это и есть смысл: пользователь замечает не её
          наличие, а её отсутствие.
        -->
        <TextView
            android:id="@+id/e2e_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_e2e_chip"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/e2e_encrypted"
            android:textColor="@color/accent_base"
            android:textSize="11sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            app:drawableStartCompat="@drawable/ic_lock_small"
            app:drawableTint="@color/accent_base" />

        <!-- Мы начали переписку, собеседник ещё не ответил. -->
        <TextView
            android:id="@+id/request_awaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="@string/request_awaiting"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        tools:listitem="@layout/item_message" />

    <!-- Строка ввода. -->
    <LinearLayout
        android:id="@+id/input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_raised"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <ImageView
            android:id="@+id/attach_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/text_secondary" />

        <org.aegis.app.components.AegisTextField
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@drawable/bg_composer_field"
            android:minHeight="44dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="@string/message_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:saveEnabled="false"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted" />
        <!-- 🔐 saveEnabled="false": черновик не попадает в сохранённое
             состояние экрана. Иначе незашифрованный текст лежал бы
             в памяти системного процесса и восстанавливался бы после
             гибели процесса приложения — в том числе без PIN. -->

        <!-- Круглая отправка 44dp (.send в UI kit). -->
        <ImageView
            android:id="@+id/send_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/send"
            android:padding="11dp"
            android:src="@drawable/ic_send"
            app:tint="@color/send_icon" />
    </LinearLayout>
</LinearLayout>
