<!--
  Экран переписки.

  Раскладка следует UI kit («Complete Mobile Screens» → Message).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Шапка: собеседник и его состояние верификации. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_raised"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/chat_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aegis_list_row"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:text="@string/back_arrow"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                tools:text="Lena Novak" />

            <!--
              🔐 Подпись о состоянии сверки. Открывает экран safety number.
              Показывается всегда, а не только при проблеме: пользователь
              должен видеть, верифицирован ли собеседник, до того как
              напишет что-то важное.
            -->
            <TextView
                android:id="@+id/chat_verification_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Не верифицирован — сверьте safety number" />
        </LinearLayout>
    </LinearLayout>

    <!--
      🔐 Предупреждение о смене identity-ключа.

      Показывается поверх переписки, а не в углу: если у верифицированного
      контакта сменился ключ, отправка блокируется до повторной сверки,
      и пользователь должен узнать об этом до того, как начнёт печатать.
    -->
    <LinearLayout
        android:id="@+id/key_change_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/key_changed_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/key_changed_body"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <org.aegis.app.components.AegisButton
            android:id="@+id/key_change_verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/verify_safety_number" />
    </LinearLayout>

        <!--
          🔐 Чип сквозного шифрования.

          Показывается всегда, а не только при первом открытии чата:
          он сообщает о состоянии защиты, и его исчезновение должно
          означать, что защиты нет. Постоянная надпись, которую нельзя
          убрать, — это и есть смысл: пользователь замечает не её
          наличие, а её отсутствие.
        -->
        <TextView
            android:id="@+id/e2e_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_e2e_chip"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/e2e_encrypted"
            android:textColor="@color/accent_base"
            android:textSize="11sp"
            app:drawableStartCompat="@drawable/ic_lock"
            app:drawableTint="@color/accent_base" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        tools:listitem="@layout/item_message" />

    <!-- Строка ввода. -->
    <LinearLayout
        android:id="@+id/input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_raised"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/attach_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach"
            android:padding="8dp"
            android:src="@drawable/ic_paperclip"
            android:tint="@color/text_secondary" />

        <org.aegis.app.components.AegisTextField
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/message_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <org.aegis.app.components.AegisButton
            android:id="@+id/send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/send" />
    </LinearLayout>
</LinearLayout>
