<!--
  Объяснение смены ключа безопасности после восстановления
  (раздел 12.5 плана).

  🔐 Зачем этот экран вообще существует. Резервная копия не содержит
  ни приватного identity-ключа, ни состояния храповика — и это
  осознанное решение: старое состояние храповика в копии означало бы
  повторное использование message key после восстановления.

  Цена решения в том, что собеседники увидят «ключ безопасности
  изменился» — ровно то предупреждение, которым приложение сообщает
  о возможной подмене. Не объяснить это здесь значит приучить
  человека игнорировать настоящую тревогу: он однажды увидел её
  без причины и перестал читать.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <TextView
            style="@style/GasAppAppBarTitle"
            android:text="@string/identity_changed_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/GasAppText.H3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identity_changed_headline" />

            <TextView
                android:id="@+id/identity_changed_summary"
                style="@style/GasAppText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/identity_changed_restored" />

            <LinearLayout
                style="@style/GasAppPanel"
                android:layout_marginTop="@dimen/space_l">

                <TextView
                    style="@style/GasAppText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/identity_changed_explain" />

                <TextView
                    style="@style/GasAppText.Caption.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/identity_changed_why" />
            </LinearLayout>

            <!--
              Что не восстановилось — списком и честно. Человек, который
              ждёт, что переписка продолжится сама, иначе решит, что
              приложение сломалось.
            -->
            <LinearLayout
                style="@style/GasAppPanel.Deep"
                android:layout_marginTop="@dimen/space_m">

                <TextView
                    style="@style/GasAppText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/identity_changed_not_restored" />
            </LinearLayout>

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/identity_changed_verify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/identity_changed_verify"
                app:buttonVariant="primary" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/identity_changed_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/identity_changed_later"
                app:buttonVariant="ghost" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
