<!--
  Экран блокировки по UI kit: щит, шесть точек, цифровая клавиатура.

  🔐 Здесь не показывается ничего, кроме запроса PIN: ни имени
  пользователя, ни числа непрочитанных, ни превью. Всё это выдало бы
  сведения о переписке тому, кто взял заблокированное устройство.

  Своя клавиатура, а не системное поле ввода: системная клавиатура
  принадлежит другому приложению, которое на Android может быть
  сторонним и видит каждое нажатие.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_shield_large"
        android:contentDescription="@string/lock_icon"
        android:padding="20dp"
        android:src="@drawable/ic_shield"
        app:tint="@color/accent_base" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/lock_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_h2"
        android:fontFamily="@font/inter"
        android:textFontWeight="700" />

    <TextView
        android:id="@+id/lock_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lock_subtitle"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/inter"
        android:textSize="14sp" />

    <!-- Шесть точек: показывают длину введённого, но не сам PIN -->
    <include
        layout="@layout/view_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pin_error"
        android:textColor="@color/status_error"
        android:textSize="12sp"
        android:visibility="invisible"
        tools:visibility="visible" />

    <!-- Цифровая клавиатура: три колонки, клавиши 56dp по макету -->
    <include
        layout="@layout/view_pin_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <!--
      «Забыли PIN?» — честный ответ вместо тупика: PIN не сбросить,
      но аккаунт возвращается ключом восстановления.
    -->
    <org.aegis.app.components.AegisButton
        android:id="@+id/lock_forgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/lock_forgot"
        app:buttonSize="small"
        app:buttonVariant="ghost" />

</LinearLayout>
