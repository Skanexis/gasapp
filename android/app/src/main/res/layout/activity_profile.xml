<!--
  Свой профиль: @имя и QR-код.

  По имени вас находят через сервер (ключ сверяет журнал ключей),
  QR несёт сам ключ — его сканируют встроенным сканером при встрече.
  Ссылки с ключом больше нет: для людей имя и QR понятнее, а ссылка
  давала ровно то же, что QR.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/profile_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:accessibilityHeading="true"
            android:text="@string/profile_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:id="@+id/profile_avatar"
                android:layout_width="@dimen/avatar_xl"
                android:layout_height="@dimen/avatar_xl"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_avatar"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/accent_base"
                android:textFontWeight="600"
                android:textSize="30sp"
                tools:text="AB" />

            <TextView
                android:id="@+id/profile_username"
                style="@style/GasAppText.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textIsSelectable="true"
                tools:text="\@anna_bk" />

            <TextView
                style="@style/GasAppText.Caption.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/profile_username_caption" />

            <!-- QR в карточке: белое поле кода нужно камере для контраста. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_qr_card"
                android:padding="@dimen/space_m">

                <ImageView
                    android:id="@+id/profile_qr"
                    android:layout_width="232dp"
                    android:layout_height="232dp"
                    android:contentDescription="@string/profile_qr_description" />
            </FrameLayout>

            <TextView
                style="@style/GasAppCaption"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/profile_qr_hint" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/profile_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/profile_share"
                app:buttonVariant="primary" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/profile_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/profile_copy"
                app:buttonVariant="ghost" />

            <!--
              Ссылка-контакт — тот же код, что в QR, текстом: тому, с кем
              не встретиться. Несёт ключ, поэтому получатель может писать
              сразу, не дожидаясь суток в журнале ключей.
            -->
            <org.gasapp.app.components.GasAppButton
                android:id="@+id/profile_share_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/profile_share_link"
                app:buttonVariant="ghost" />

            <TextView
                style="@style/GasAppCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/profile_share_link_hint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
