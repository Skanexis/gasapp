<!--
  Список чатов по UI kit: шапка с поиском, список, кнопка нового чата
  и нижняя навигация.

  FrameLayout снаружи нужен только ради FAB: он лежит поверх списка,
  как в макете, и в линейной раскладке этого не добиться.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="14dp">

            <TextView
                style="@style/AegisAppBarTitle"
                android:layout_weight="1"
                android:text="@string/nav_chats" />

            <ImageView
                android:id="@+id/chat_list_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/security_center_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/security_center_description"
                android:src="@drawable/ic_shield"
                android:tint="@color/status_ok" />
        </LinearLayout>

        <!--
          Баннер соединения: по умолчанию скрыт.

          Показывается только когда связи нет. Постоянный зелёный
          индикатор «онлайн» приучает не смотреть на него, и в момент,
          когда он действительно понадобится, его не заметят.
        -->
        <TextView
            android:id="@+id/connection_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/status_warn_dim"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/connection_offline"
            android:textColor="@color/status_warn"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_chat" />

        <TextView
            android:id="@+id/chat_list_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:text="@string/chat_list_empty"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />

        <include layout="@layout/view_bottom_nav" />

    </LinearLayout>

    <!-- Кнопка нового чата: 52dp, отступ снизу 86dp по макету -->
    <ImageView
        android:id="@+id/new_chat_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/new_chat"
        android:padding="14dp"
        android:src="@drawable/ic_edit"
        android:tint="@color/accent_on" />

</FrameLayout>
