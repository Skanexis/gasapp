<!--
  Список чатов по UI kit: шапка с поиском, список, кнопка нового чата
  и нижняя навигация.

  Кнопка нового чата лежит в области списка, над навигацией, а не поверх
  всего экрана с отступом «на глаз»: прежде отступ был числом (64dp),
  навигация — выше, и кнопка наезжала на неё.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_s">

            <TextView
                style="@style/AegisAppBarTitle.Large"
                android:layout_weight="1"
                android:text="@string/nav_chats" />

            <!-- Значок 24dp, область нажатия 48dp (AegisIconButton). -->
            <ImageView
                android:id="@+id/chat_list_search"
                style="@style/AegisIconButton"
                android:padding="12dp"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/security_center_badge"
                style="@style/AegisIconButton"
                android:padding="12dp"
                android:contentDescription="@string/security_center_description"
                android:src="@drawable/ic_shield"
                app:tint="@color/status_ok" />
        </LinearLayout>

        <!--
          Баннер соединения: по умолчанию скрыт.

          Показывается только когда связи нет. Постоянный зелёный
          индикатор «онлайн» приучает не смотреть на него, и в момент,
          когда он действительно понадобится, его не заметят.
        -->
        <TextView
            android:id="@+id/connection_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/status_warn_dim"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/connection_offline"
            android:textColor="@color/status_warn"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- Запас снизу — под кнопку нового чата: последняя строка не прячется под ней. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_chat" />

        <include
            android:id="@+id/chat_list_empty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Кнопка нового чата: 52dp, 16dp от края и от навигации. -->
        <ImageView
            android:id="@+id/new_chat_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/screen_padding"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/new_chat"
            android:elevation="6dp"
            android:padding="14dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/accent_on" />

        </FrameLayout>

        <include layout="@layout/view_bottom_nav" />

</LinearLayout>
