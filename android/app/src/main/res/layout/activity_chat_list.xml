<!--
  Экран списка чатов — главный экран приложения.

  Раскладка следует UI kit («Complete Mobile Screens» → Chat List).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Шапка: имя приложения и вход в Security Center. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_raised"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!--
          🔐 Индикатор Security Center. Показывает счёт защищённости
          и открывает список предупреждений: смена ключа контакта,
          недоступность аппаратного хранилища, просроченный backup.
          Значок всегда на виду, а не спрятан в меню — иначе о тревоге
          узнают только те, кто и так осторожен.
        -->
        <TextView
            android:id="@+id/security_center_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aegis_list_row"
            android:contentDescription="@string/security_center_description"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/accent_base"
            android:textSize="13sp"
            tools:text="🛡 9/10" />
    </LinearLayout>

    <!--
      Состояние соединения. Показывается только когда связи нет:
      постоянный зелёный индикатор «онлайн» приучает не смотреть на него,
      и тогда пропадание связи остаётся незамеченным.
    -->
    <TextView
        android:id="@+id/connection_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="@string/connection_offline"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:listitem="@layout/item_chat" />

    <!--
      Пустое состояние. Отдельный текст, а не пустой экран: пользователь
      должен понимать, что приложение работает, а не сломалось.
    -->
    <TextView
        android:id="@+id/chat_list_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/screen_padding"
        android:text="@string/chat_list_empty"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="gone" />
</LinearLayout>
