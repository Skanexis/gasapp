<!--
  Поиск по переписке.

  Ищет по расшифрованной базе на устройстве. Ни запрос, ни результаты
  наружу не уходят: сервер о поиске не знает вовсе.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!--
      Шапка как на остальных экранах (GasAppAppBar): «назад» и
      заголовок. Отрицательный отступ сверху компенсирует отступ
      экрана, чтобы заголовок стоял на той же высоте.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/search_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:accessibilityHeading="true"
            android:text="@string/search_title" />
    </LinearLayout>

    <org.gasapp.app.components.GasAppTextField
        android:id="@+id/search_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:fieldIcon="@drawable/ic_search"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/search_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
