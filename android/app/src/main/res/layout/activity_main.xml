<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/core_version_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Core Version: Loading..."
        android:textSize="16sp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/protocol_version_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Protocol Version: Loading..."
        android:textSize="16sp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/core_version_text" />

    <TextView
        android:id="@+id/safety_number_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Safety Number: Loading..."
        android:textSize="16sp"
        android:padding="16dp"
        android:monospace="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/protocol_version_text" />

</androidx.constraintlayout.widget.ConstraintLayout>