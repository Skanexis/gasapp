<!--
  Пустое состояние по UI kit (File Management, «No files yet»): значок
  32dp приглушённым цветом, заголовок, пояснение и — если есть что
  сделать — одно действие. Заполняется EmptyState.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl">

    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="@dimen/icon_l"
        android:layout_height="@dimen/icon_l"
        android:importantForAccessibility="no"
        app:tint="@color/text_muted"
        tools:src="@drawable/ic_chat" />

    <TextView
        android:id="@+id/empty_title"
        style="@style/AegisText.H4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        tools:text="No conversations yet" />

    <TextView
        android:id="@+id/empty_body"
        style="@style/AegisText.Caption.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        tools:text="Find someone by username to start one." />

    <org.aegis.app.components.AegisButton
        android:id="@+id/empty_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:visibility="gone"
        app:buttonSize="small"
        app:buttonVariant="secondary"
        tools:text="Start a chat"
        tools:visibility="visible" />
</LinearLayout>
