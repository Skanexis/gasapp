<!--
  Security Center по UI kit: кольцевой счёт и список проверок.

  🔐 Смысл экрана — показать, что именно проверено, а не поставить
  оценку. Поэтому под кольцом стоит список проверок, собираемый кодом
  из реального состояния: непройденные — первыми и с переходом туда,
  где их исправляют. Прежде счёт был константой «9 из 10».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/security_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/AegisAppBarTitle"
            android:layout_marginStart="12dp"
            android:text="@string/security_center_title"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Карточка счёта -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/score_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/bg_score_ring" />

            <TextView
                android:id="@+id/score_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/status_ok"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                tools:text="6/8" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/score_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_attention_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold" />

            <TextView
                android:id="@+id/score_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                tools:text="2 пункта требуют внимания" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/security_section_checks" />

            <!-- Заполняется кодом: состав зависит от состояния устройства. -->
            <LinearLayout
                android:id="@+id/security_checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/security_section_details" />

            <include android:id="@+id/security_keys" layout="@layout/item_settings_row" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@drawable/divider_row" />

            <include android:id="@+id/security_devices" layout="@layout/item_settings_row" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@drawable/divider_row" />

            <include android:id="@+id/security_recovery" layout="@layout/item_settings_row" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@drawable/divider_row" />

            <include android:id="@+id/security_blocked" layout="@layout/item_settings_row" />

            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/security_section_log" />

            <!-- Заполняется кодом: последние события журнала безопасности. -->
            <LinearLayout
                android:id="@+id/security_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
