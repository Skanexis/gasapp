<!--
  Security Center по UI kit (Security health): кольцевой счёт
  и проверки группами.

  🔐 Смысл экрана — показать, что именно проверено, а не поставить
  оценку. Поэтому под кольцом стоят проверки, собираемые кодом
  из реального состояния: непройденные — отдельной группой сверху
  и с переходом туда, где их исправляют. Прежде счёт был константой
  «9 из 10».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/security_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:accessibilityHeading="true"
            android:text="@string/security_center_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_l">

            <!-- Счёт: кольцо крупно, итог словами под ним. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_l"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_l">

                <!--
                  Итог — сама розетка: кольцо на каждую проверку, пройденная
                  прорисована «чернилами» цвета итога. Не прогресс ради
                  украшения, а тот же знак, что на входе: защита собрана
                  из этих колец.
                -->
                <FrameLayout
                    android:layout_width="176dp"
                    android:layout_height="176dp">

                    <org.gasapp.app.components.GuillocheView
                        android:id="@+id/score_seal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/score_value"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:textColor="@color/status_ok"
                        android:textFontWeight="700"
                        android:textSize="22sp"
                        tools:text="6/12" />
                </FrameLayout>

                <TextView
                    android:id="@+id/score_title"
                    style="@style/GasAppText.H3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/security_attention_title" />

                <TextView
                    android:id="@+id/score_subtitle"
                    style="@style/GasAppText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    tools:text="6 пунктов требуют внимания" />
            </LinearLayout>

            <!--
              Проверки — двумя группами, заполняются кодом: состав
              зависит от состояния устройства. Пустая группа прячется
              вместе с подписью.
            -->
            <TextView
                android:id="@+id/security_attention_label"
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/security_attention_title"
                android:visibility="gone"
                tools:visibility="visible" />

            <org.gasapp.app.components.GasAppGroup
                android:id="@+id/security_checks_attention"
                style="@style/GasAppGroup"
                android:layout_marginTop="@dimen/space_l"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/security_passed_label"
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/security_section_passed"
                android:visibility="gone"
                tools:visibility="visible" />

            <org.gasapp.app.components.GasAppGroup
                android:id="@+id/security_checks_passed"
                style="@style/GasAppGroup"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/security_section_details" />

            <org.gasapp.app.components.GasAppGroup style="@style/GasAppGroup">

                <include android:id="@+id/security_keys" layout="@layout/item_settings_row" />

                <include android:id="@+id/security_devices" layout="@layout/item_settings_row" />

                <include android:id="@+id/security_recovery" layout="@layout/item_settings_row" />

                <include android:id="@+id/security_blocked" layout="@layout/item_settings_row" />
            </org.gasapp.app.components.GasAppGroup>

            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/security_section_log" />

            <!-- Заполняется кодом: последние события журнала безопасности. -->
            <org.gasapp.app.components.GasAppGroup
                android:id="@+id/security_log"
                style="@style/GasAppGroup" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
