<!--
  Security Center по UI kit: кольцевой счёт и список проверок.

  🔐 Смысл экрана — показать, что именно проверено, а не поставить
  оценку. Одна цифра без разбивки создавала бы ложное чувство
  защищённости: «9 из 10» ничего не говорит о том, какой пункт
  не выполнен и чем это грозит.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/security_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            style="@style/AegisAppBarTitle"
            android:layout_marginStart="12dp"
            android:text="@string/security_center_title"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Карточка счёта -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/score_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/bg_score_ring" />

            <TextView
                android:id="@+id/score_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/status_ok"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="9/10" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/score_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_protected"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                tools:text="1 пункт требует внимания" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/security_keys" layout="@layout/item_settings_row" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@drawable/divider_row" />

            <include android:id="@+id/security_devices" layout="@layout/item_settings_row" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@drawable/divider_row" />

            <include android:id="@+id/security_recovery" layout="@layout/item_settings_row" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@drawable/divider_row" />

            <include android:id="@+id/security_blocked" layout="@layout/item_settings_row" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
