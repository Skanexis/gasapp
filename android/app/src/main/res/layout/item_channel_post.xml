<!--
  Запись канала: карточка во всю ширину ленты, время — под текстом.
  Запись — не реплика в разговоре, поэтому это не пузырь с хвостиком,
  а лист: у канала один голос, и сторону различать не нужно.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_padding"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginEnd="@dimen/screen_padding"
    android:layout_marginBottom="@dimen/space_xs"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/post_text"
        style="@style/GasAppText.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="none"
        android:textIsSelectable="true"
        tools:text="Сегодня в 20:00 — прямой эфир. Ссылка появится здесь же за десять минут до начала." />

    <TextView
        android:id="@+id/post_time"
        style="@style/GasAppText.Caption.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        tools:text="7 окт., 19:42" />

</LinearLayout>
