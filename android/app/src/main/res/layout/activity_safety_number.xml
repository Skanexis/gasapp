<!--
  Экран сверки safety number.

  Единственное место, где криптографическую проверку выполняет **человек**,
  поэтому форма здесь — решение о безопасности, а не об оформлении
  (ADR-022): 60 десятичных цифр, 12 групп по 5, моноширинный шрифт.

  Hex из первой редакции UI kit заменён намеренно: при сверке голосом
  и глазами путаются B/8 и D/0, а ошибка сверки означает, что пользователь
  считает канал проверенным, когда он не проверен.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/screen_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:accessibilityHeading="true"
            android:text="@string/safety_number_title" />
    </LinearLayout>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:id="@+id/safety_number_peer"
            style="@style/GasAppText.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="Сверка с Lena Novak" />

        <!--
          Место под QR-код. Содержит protobuf {version, fingerprint_bytes,
          identifier}; при сканировании сравнение выполняется
          в constant-time (раздел 6.6).
        -->
        <ImageView
            android:id="@+id/safety_number_qr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_qr_card"
            android:contentDescription="@string/safety_number_qr_description"
            android:padding="6dp" />

        <!--
          Цифры моноширинным шрифтом: при сверке глазами группы должны
          выстраиваться в колонки, иначе сбивается счёт.
        -->
        <TextView
            android:id="@+id/safety_number_digits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_card_rounded"
            android:fontFamily="monospace"
            app:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:lineSpacingExtra="6dp"
            android:padding="@dimen/space_l"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="18sp"
            tools:text="38679 09329 07961\n31636 68792 91538\n01705 09531 22053\n70951 53139 67810" />

        <TextView
            style="@style/GasAppText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/safety_number_hint" />

        <!--
          🔐 Отметка о сверке ставится вручную и только пользователем.
          Автоматическая отметка обесценила бы верификацию: она означает
          «я лично сверил», а не «приложение что-то посчитало».
        -->
        <!--
          Сканирование кода собеседника: устройство сравнивает все 60
          цифр само — быстрее и точнее, чем глазами. Совпало — отметка
          ставится; не совпало — предупреждение о возможной подмене.
        -->
        <org.gasapp.app.components.GasAppButton
            android:id="@+id/scan_safety_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:drawablePadding="@dimen/space_s"
            android:text="@string/safety_scan"
            app:buttonVariant="primary" />

        <org.gasapp.app.components.GasAppButton
            android:id="@+id/mark_verified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/mark_verified"
            app:buttonVariant="outline" />

        <org.gasapp.app.components.GasAppButton
            android:id="@+id/clear_verified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/clear_verified"
            app:buttonVariant="ghost" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
