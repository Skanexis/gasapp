<!--
  Показ ключа восстановления — один раз за всю его жизнь.

  🔐 Экран всегда под FLAG_SECURE, независимо от настройки блокировки
  снимков: настройку можно выключить, а ключ на скриншоте попадает
  в галерею и оттуда в облако. Это единственное место приложения,
  где флаг не подчиняется пользовательскому выбору.

  Ключ показан моноширинным шрифтом группами по четыре символа —
  ровно так, как его будут переписывать от руки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/key_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/recovery_key_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/GasAppText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recovery_key_explain" />

            <!--
              Сам ключ. Моноширинный шрифт обязателен: в нём 0 и O,
              1 и I различимы — а именно их путают при переписывании.
              Алфавит Crockford этих символов не содержит, но человек
              всё равно сверяет написанное с показанным.
            -->
            <LinearLayout
                style="@style/GasAppPanel.Deep"
                android:layout_marginTop="@dimen/space_l">

                <TextView
                    android:id="@+id/key_value"
                    style="@style/GasAppText.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:textIsSelectable="false"
                    tools:text="GASAPP-7F2K-9QMD-X4RT-B81N-KV5C-2WPH-E6JZ-3A5T-M9XN-P2QW-R7YK-4DV6-H8CF" />
            </LinearLayout>

            <!--
              🔐 Предупреждение о единственности показа — над кнопкой,
              а не под ней: его читают до нажатия.
            -->
            <TextView
                style="@style/GasAppText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/recovery_key_once"
                android:textColor="@color/status_warn" />

            <TextView
                style="@style/GasAppText.Caption.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/recovery_key_no_screenshot" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/key_written"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/recovery_key_written"
                app:buttonVariant="primary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
