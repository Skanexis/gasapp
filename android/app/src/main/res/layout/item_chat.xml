<!--
  Строка списка чатов по UI kit: аватар 48dp с точкой присутствия
  и значком верификации, имя, превью, время и бейдж непрочитанных.

  🔐 Аватар — буква имени, а не загруженное фото: запрос картинки
  с сервера выдал бы оператору, кто с кем переписывается.
-->
<org.gasapp.app.components.GasAppListRow xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/chat_row_padding_vertical"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/chat_row_padding_vertical">

    <!-- Аватар и его значки лежат в FrameLayout: точка и галочка
         позиционируются поверх круга, как в макете. -->
    <FrameLayout
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size">

        <TextView
            android:id="@+id/chat_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/accent_base"
            android:textSize="16sp"
            tools:text="LN" />

        <View
            android:id="@+id/chat_presence"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_presence_dot"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/chat_verified"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_verified_badge"
            android:contentDescription="@string/chat_verified_mark"
            android:padding="3dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_on"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Lena Novak" />

        <TextView
            android:id="@+id/chat_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:textFontWeight="400"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            tools:text="Проверим safety number?" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textFontWeight="400"
            android:includeFontPadding="false"
            android:textColor="@color/text_disabled"
            android:textSize="11sp"
            tools:text="14:32" />

        <TextView
            android:id="@+id/chat_unread"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_unread_badge"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:includeFontPadding="false"
            android:textColor="@color/accent_on"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />
    </LinearLayout>

</org.gasapp.app.components.GasAppListRow>
