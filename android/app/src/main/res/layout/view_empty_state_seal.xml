<!--
  Пустое состояние со сценой GasApp — для пустых списков верхнего
  уровня (чаты, каналы): ночная поляна, на её краю — золотой жетон
  со значком раздела, ниже заголовок, пояснение и одно действие.
  Те же id, что у view_empty_state: заполняется тем же EmptyState.

  Имя файла осталось от прежнего знака (розетки): на него ссылаются
  раскладки списков.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl">

    <!-- Жетон выступает за нижний край сцены на половину своей высоты. -->
    <FrameLayout
        android:layout_width="216dp"
        android:layout_height="164dp">

        <org.gasapp.app.components.NightSceneView
            android:layout_width="match_parent"
            android:layout_height="136dp"
            app:sceneFade="false"
            app:sceneRadius="@dimen/radius_sheet" />

        <ImageView
            android:id="@+id/empty_icon"
            android:layout_width="56dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_token"
            android:importantForAccessibility="no"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp"
            app:tint="@color/accent_on"
            tools:src="@drawable/ic_chat" />
    </FrameLayout>

    <TextView
        android:id="@+id/empty_title"
        style="@style/GasAppText.H3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:fontFamily="@font/rubik"
        android:gravity="center"
        android:textFontWeight="900"
        tools:text="No conversations yet" />

    <TextView
        android:id="@+id/empty_body"
        style="@style/GasAppText.Caption.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        tools:text="Find someone by username to start one." />

    <org.gasapp.app.components.GasAppButton
        android:id="@+id/empty_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:visibility="gone"
        app:gasappButtonSize="small"
        app:buttonVariant="primary"
        tools:text="Start a chat"
        tools:visibility="visible" />

</LinearLayout>
