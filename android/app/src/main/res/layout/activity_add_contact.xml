<!--
  Новый собеседник: по @имени или по QR-коду.

  🔐 Два пути разной силы, и экран это не прячет. Имя сервер превращает
  в ключ сам — ключ сверяется открытым журналом ключей (писать можно
  сразу, если аккаунту больше суток). QR-код несёт сам ключ и приходит
  мимо сервера: это точная сверка без ожидания.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/screen_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:accessibilityHeading="true"
            android:text="@string/new_chat" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_s"
                android:labelFor="@id/add_contact_username"
                android:text="@string/onboarding_username_label" />

            <org.gasapp.app.components.GasAppTextField
                android:id="@+id/add_contact_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_chat_field_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLength="512"
                android:maxLines="1"
                app:fieldIcon="@drawable/ic_search" />

            <!-- Подсказка, на её место встаёт итог (UI kit, Inputs). -->
            <TextView
                android:id="@+id/add_contact_status"
                style="@style/GasAppCaption"
                android:layout_marginTop="@dimen/space_s"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="6dp"
                android:text="@string/add_contact_username_helper" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/add_contact_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/add_contact_open"
                app:buttonVariant="primary" />

            <!-- «или» между двумя путями. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/line" />

                <TextView
                    style="@style/GasAppText.Caption.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_m"
                    android:text="@string/add_contact_or" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/line" />
            </LinearLayout>

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/add_contact_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:drawablePadding="@dimen/space_s"
                android:text="@string/add_contact_scan"
                app:buttonVariant="outline" />

            <TextView
                style="@style/GasAppCaption"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/add_contact_scan_helper" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
