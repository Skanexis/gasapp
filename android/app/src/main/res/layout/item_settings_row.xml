<!--
  Строка настроек по UI kit: иконка, подпись, значение, шеврон.
  Отступы 13dp/16dp и промежуток 14dp перенесены дословно.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="16dp"
    android:paddingBottom="13dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_shield"
        android:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        tools:text="Безопасность" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Тёмная"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:rotation="180"
        android:src="@drawable/ic_back"
        android:tint="@color/text_disabled" />

</LinearLayout>
