<!--
  Нижняя навигация: Chats / Calls / Contacts / Settings.

  Размеры перенесены из UI kit дословно: иконка 21dp, подпись 10sp,
  отступ снизу 16dp под системную полосу жестов.

  Включается в экраны через <include>, а не наследуется от общей
  Activity: экраны без навигации (блокировка, сверка safety number)
  не должны её получать случайно.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_raised"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/nav_chats"
        style="@style/AegisNavItem">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chat"
            android:tint="@color/accent_base" />

        <TextView
            style="@style/AegisNavLabel"
            android:text="@string/nav_chats"
            android:textColor="@color/accent_base" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_calls"
        style="@style/AegisNavItem">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone"
            android:tint="@color/text_disabled" />

        <TextView
            style="@style/AegisNavLabel"
            android:text="@string/nav_calls" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_contacts"
        style="@style/AegisNavItem">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_users"
            android:tint="@color/text_disabled" />

        <TextView
            style="@style/AegisNavLabel"
            android:text="@string/nav_contacts" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings"
        style="@style/AegisNavItem">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_disabled" />

        <TextView
            style="@style/AegisNavLabel"
            android:text="@string/nav_settings" />
    </LinearLayout>

</LinearLayout>
