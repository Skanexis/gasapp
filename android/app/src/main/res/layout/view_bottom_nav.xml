<!--
  Нижняя навигация: Chats / Channels / Contacts / Settings (Calls скрыта).

  Размеры перенесены из UI kit дословно: иконка 21dp, подпись 10sp,
  отступ снизу 16dp под системную полосу жестов.

  Включается в экраны через <include>, а не наследуется от общей
  Activity: экраны без навигации (блокировка, сверка safety number)
  не должны её получать случайно.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_raised"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/nav_chats"
        style="@style/GasAppNavItem">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingStart="17dp"
            android:paddingTop="4dp"
            android:paddingEnd="17dp"
            android:paddingBottom="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chat"
            app:tint="@color/accent_base" />

        <TextView
            style="@style/GasAppNavLabel"
            android:text="@string/nav_chats"
            android:textColor="@color/accent_base" />
    </LinearLayout>

    <!--
      Звонков в продукте нет — и вкладка их не обещает. Четверть
      навигации ради «Звонков в этой версии нет» учила искать то, чего
      нет. Экран (`CallsActivity`) остаётся: вкладка вернётся вместе
      со звонками.
    -->
    <LinearLayout
        android:id="@+id/nav_calls"
        style="@style/GasAppNavItem"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingStart="17dp"
            android:paddingTop="4dp"
            android:paddingEnd="17dp"
            android:paddingBottom="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone"
            app:tint="@color/text_tertiary" />

        <TextView
            style="@style/GasAppNavLabel"
            android:text="@string/nav_calls" />
    </LinearLayout>

    <!-- Каналы: ленты, которые человек читает или ведёт. -->
    <LinearLayout
        android:id="@+id/nav_channels"
        style="@style/GasAppNavItem">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingStart="17dp"
            android:paddingTop="4dp"
            android:paddingEnd="17dp"
            android:paddingBottom="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_channel"
            app:tint="@color/text_tertiary" />

        <TextView
            style="@style/GasAppNavLabel"
            android:text="@string/nav_channels" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_contacts"
        style="@style/GasAppNavItem">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingStart="17dp"
            android:paddingTop="4dp"
            android:paddingEnd="17dp"
            android:paddingBottom="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_users"
            app:tint="@color/text_tertiary" />

        <TextView
            style="@style/GasAppNavLabel"
            android:text="@string/nav_contacts" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings"
        style="@style/GasAppNavItem">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingStart="17dp"
            android:paddingTop="4dp"
            android:paddingEnd="17dp"
            android:paddingBottom="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_tertiary" />

        <TextView
            style="@style/GasAppNavLabel"
            android:text="@string/nav_settings" />
    </LinearLayout>

</LinearLayout>
