<!--
  О программе.

  Версии ядра и протокола показаны, потому что от них зависит
  совместимость: собеседник со старым протоколом не сможет прочитать
  сообщение, и знать номер полезно раньше, чем начнётся разбирательство.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/AegisAppBar">

        <ImageView
            android:id="@+id/about_back"
            style="@style/AegisIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/AegisAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_about" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/AegisSectionLabel"
                android:text="@string/about_section_version" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/about_app_version"
                    layout="@layout/item_settings_row" />

<include
                    android:id="@+id/about_core_version"
                    layout="@layout/item_settings_row" />

<include
                    android:id="@+id/about_protocol_version"
                    layout="@layout/item_settings_row" />
            </org.aegis.app.components.AegisGroup>
            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/about_section_legal" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/about_license"
                    layout="@layout/item_settings_row" />

<include
                    android:id="@+id/about_source"
                    layout="@layout/item_settings_row" />
            </org.aegis.app.components.AegisGroup>
            <TextView
                style="@style/AegisCaption"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/about_note" />

            <!--
              🔐 Пределы защиты — на экране, а не только в политике
              приватности: человек решает, чем пользоваться, по тому,
              что видит в приложении. Каждый пункт сверен с кодом
              (MASVS PRIVACY-2.2).
            -->
            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/about_section_limits" />

            <LinearLayout
                style="@style/AegisPanel"
                android:id="@+id/about_limits">

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_first_message" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_address" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_notifications" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_backup" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_recovery_key" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_peer" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_calls" />

            <TextView
                style="@style/AegisText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_limit_inactive" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
