<!--
  Приватность.

  🔐 Все настройки здесь меняют то, что узнаёт о пользователе кто-то
  другой: собеседник, система, тот, кто взял устройство в руки.
  Поэтому у каждой есть пояснение: название вроде «Индикаторы
  присутствия» не говорит, что именно станет видно.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/privacy_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_privacy" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/GasAppSectionLabel"
                android:text="@string/privacy_section_contacts" />

            <org.gasapp.app.components.GasAppGroup style="@style/GasAppGroup">

                <include
                    android:id="@+id/privacy_presence"
                    layout="@layout/item_settings_toggle" />

<include
                    android:id="@+id/privacy_last_seen"
                    layout="@layout/item_settings_toggle" />
            </org.gasapp.app.components.GasAppGroup>

            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/privacy_section_device" />

            <org.gasapp.app.components.GasAppGroup style="@style/GasAppGroup">

                <include
                    android:id="@+id/privacy_screenshots"
                    layout="@layout/item_settings_toggle" />
            </org.gasapp.app.components.GasAppGroup>

            <!--
              🔐 Сеть: IP-адрес — последняя крупная утечка раздела 15.5.
              Строка ведёт на отдельный экран: выбор прокси требует
              пояснений, которые не помещаются в переключатель.
            -->
            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/privacy_section_network" />

            <org.gasapp.app.components.GasAppGroup style="@style/GasAppGroup">

                <include
                    android:id="@+id/privacy_network"
                    layout="@layout/item_settings_row" />
            </org.gasapp.app.components.GasAppGroup>

            <!--
              🔐 Удаление аккаунта (MASVS PRIVACY-3.2).

              Внизу и отдельной секцией: действие необратимо, и стоять
              рядом с переключателями, которые можно вернуть обратно,
              оно не должно.
            -->
            <TextView
                style="@style/GasAppSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/privacy_section_account" />

            <org.gasapp.app.components.GasAppGroup style="@style/GasAppGroup">

                <include
                    android:id="@+id/privacy_autolock"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/privacy_biometric"
                    layout="@layout/item_settings_toggle" />

                <include
                    android:id="@+id/privacy_wipe"
                    layout="@layout/item_settings_toggle" />

                <include
                    android:id="@+id/privacy_export"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/privacy_delete_account"
                    layout="@layout/item_settings_row" />
            </org.gasapp.app.components.GasAppGroup>

            <TextView
                style="@style/GasAppCaption"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/privacy_delete_account_hint" />

            <!--
              🔐 Пояснение о пределах защиты.

              Блокировка снимков экрана не мешает сфотографировать
              экран другим телефоном и не действует на собеседника.
              Обещать больше, чем платформа даёт, — хуже, чем
              не обещать ничего: пользователь строит поведение
              на защите, которой нет.
            -->
            <TextView
                style="@style/GasAppCaption"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/privacy_limits_note" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
