<!--
  Хранилище.

  🔐 Всё, что показано здесь, лежит в зашифрованной базе на устройстве.
  Освобождение места удаляет данные безвозвратно: восстановить их
  из резервной копии сервера нельзя — сервер их не хранит.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/AegisAppBar">

        <ImageView
            android:id="@+id/storage_back"
            style="@style/AegisIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/AegisAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_storage" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/AegisSectionLabel"
                android:text="@string/storage_section_usage" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/storage_messages"
                    layout="@layout/item_settings_row" />

<include
                    android:id="@+id/storage_attachments"
                    layout="@layout/item_settings_row" />
            </org.aegis.app.components.AegisGroup>
            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/storage_section_cleanup" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/storage_purge_expired"
                    layout="@layout/item_settings_row" />

<include
                    android:id="@+id/storage_clear_cache"
                    layout="@layout/item_settings_row" />
            </org.aegis.app.components.AegisGroup>
            <TextView
                style="@style/AegisCaption"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/storage_cleanup_note" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
