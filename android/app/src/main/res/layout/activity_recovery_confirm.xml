<!--
  Подтверждение записи ключа: три случайные группы (раздел 12.3).

  🔐 Проверка существует ровно затем, чтобы пользователь не пролистал
  показ ключа не глядя. Правило раздела 12.3 прямое: без подтверждения
  половина людей потеряет доступ к своим данным — и узнает об этом
  в тот момент, когда данные понадобятся.

  Группы спрашиваются случайные, а не первые три: первые запоминаются
  без записи.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/confirm_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/recovery_confirm_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/GasAppText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recovery_confirm_explain" />

            <LinearLayout
                style="@style/GasAppPanel"
                android:layout_marginTop="@dimen/space_l">

                <TextView
                    android:id="@+id/confirm_label_first"
                    style="@style/GasAppSectionLabel"
                    tools:text="Группа 3" />

                <org.gasapp.app.components.GasAppTextField
                    android:id="@+id/confirm_input_first"
                    style="@style/GasAppInput"
                    android:layout_width="match_parent"
                    android:autofillHints=""
                    android:fontFamily="monospace"
                    app:fontFamily="monospace"
                    android:hint="@string/recovery_confirm_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="4"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/confirm_label_second"
                    style="@style/GasAppSectionLabel"
                    android:layout_marginTop="@dimen/space_m"
                    tools:text="Группа 7" />

                <org.gasapp.app.components.GasAppTextField
                    android:id="@+id/confirm_input_second"
                    style="@style/GasAppInput"
                    android:layout_width="match_parent"
                    android:autofillHints=""
                    android:fontFamily="monospace"
                    app:fontFamily="monospace"
                    android:hint="@string/recovery_confirm_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="4"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/confirm_label_third"
                    style="@style/GasAppSectionLabel"
                    android:layout_marginTop="@dimen/space_m"
                    tools:text="Группа 11" />

                <org.gasapp.app.components.GasAppTextField
                    android:id="@+id/confirm_input_third"
                    style="@style/GasAppInput"
                    android:layout_width="match_parent"
                    android:autofillHints=""
                    android:fontFamily="monospace"
                    app:fontFamily="monospace"
                    android:hint="@string/recovery_confirm_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="4"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/confirm_status"
                style="@style/GasAppText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone"
                tools:text="Группы не совпали"
                tools:visibility="visible" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/confirm_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/recovery_confirm_submit"
                app:buttonVariant="primary" />

            <!--
              Возврат к показу ключа: человек, не успевший переписать,
              должен иметь путь назад, а не терять ключ из-за того, что
              нажал «дальше» слишком рано.
            -->
            <org.gasapp.app.components.GasAppButton
                android:id="@+id/confirm_show_again"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/recovery_confirm_show_again"
                app:buttonVariant="ghost" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
