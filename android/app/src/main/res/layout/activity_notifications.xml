<!--
  Уведомления.

  🔐 Само уведомление приходит без содержимого: сервер отправляет
  только флаг «есть новое», а текста, отправителя и чата в нём нет
  (ADR-014). Всё, что настраивается здесь, — что подставит приложение
  уже на устройстве, после расшифровки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/AegisAppBar">

        <ImageView
            android:id="@+id/notifications_back"
            style="@style/AegisIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/AegisAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/AegisSectionLabel"
                android:text="@string/notifications_section_content" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/notifications_preview"
                    layout="@layout/item_settings_toggle" />

<include
                    android:id="@+id/notifications_sender"
                    layout="@layout/item_settings_toggle" />
            </org.aegis.app.components.AegisGroup>
            <TextView
                style="@style/AegisCaption"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/notifications_content_note" />
            <TextView
                style="@style/AegisSectionLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/notifications_section_alerts" />
            <org.aegis.app.components.AegisGroup style="@style/AegisGroup">

                <include
                    android:id="@+id/notifications_sound"
                    layout="@layout/item_settings_toggle" />

<include
                    android:id="@+id/notifications_vibrate"
                    layout="@layout/item_settings_toggle" />
            </org.aegis.app.components.AegisGroup>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
