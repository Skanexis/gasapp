<!--
  Уведомления (ADR-040).

  🔐 Уведомление приходит, пока приложение заперто, и расшифровать ему
  нечего: в нём нет ни текста, ни отправителя — только «есть новое».
  Настраивается здесь, приходит ли оно вообще; звук и вибрация — в
  системных настройках канала.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <LinearLayout style="@style/GasAppAppBar">

        <ImageView
            android:id="@+id/notifications_back"
            style="@style/GasAppIconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/GasAppAppBarTitle"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/settings_notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:defaultFocusHighlightEnabled="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <org.gasapp.app.components.GasAppGroup style="@style/GasAppGroup">

                <include
                    android:id="@+id/notifications_enabled"
                    layout="@layout/item_settings_toggle" />

                <include
                    android:id="@+id/notifications_sound"
                    layout="@layout/item_settings_row" />
            </org.gasapp.app.components.GasAppGroup>

            <!-- Почему уведомлений сейчас не будет: запрет системы или Tor. -->
            <TextView
                android:id="@+id/notifications_state"
                style="@style/GasAppCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textColor="@color/status_warn"
                android:visibility="gone" />

            <org.gasapp.app.components.GasAppButton
                android:id="@+id/notifications_allow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/notifications_allow"
                android:visibility="gone"
                app:buttonVariant="secondary" />

            <TextView
                style="@style/GasAppCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/notifications_how" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
