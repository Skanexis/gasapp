<?xml version="1.0" encoding="utf-8"?>
<!--
  🔐 Цифровая клавиатура для PIN — своя, не системная.

  Системную клавиатуру поставляет кто угодно: сторонняя получает каждое
  нажатие и вправе запомнить его или отправить куда угодно. PIN здесь —
  половина ключа базы, поэтому набирается только этой клавиатурой.

  Три колонки, клавиши 56dp по макету. Общая для экрана входа
  и всех мест, где набирается PIN (PinPad).
-->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keypad"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:columnCount="3">

    <TextView android:id="@+id/key_1" style="@style/AegisKeypadKey" android:text="1" />
    <TextView android:id="@+id/key_2" style="@style/AegisKeypadKey" android:text="2" />
    <TextView android:id="@+id/key_3" style="@style/AegisKeypadKey" android:text="3" />
    <TextView android:id="@+id/key_4" style="@style/AegisKeypadKey" android:text="4" />
    <TextView android:id="@+id/key_5" style="@style/AegisKeypadKey" android:text="5" />
    <TextView android:id="@+id/key_6" style="@style/AegisKeypadKey" android:text="6" />
    <TextView android:id="@+id/key_7" style="@style/AegisKeypadKey" android:text="7" />
    <TextView android:id="@+id/key_8" style="@style/AegisKeypadKey" android:text="8" />
    <TextView android:id="@+id/key_9" style="@style/AegisKeypadKey" android:text="9" />

    <!-- Пустая клетка слева от нуля: в макете здесь биометрия.
         Вход по отпечатку экран входа предлагает сам, системным окном
         при открытии, — клавиша для него не нужна -->

    <Space
        android:layout_width="72dp"
        android:layout_height="56dp" />

    <TextView android:id="@+id/key_0" style="@style/AegisKeypadKey" android:text="0" />

    <ImageView
        android:id="@+id/key_delete"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_keypad_key"
        android:contentDescription="@string/delete_digit"
        android:padding="16dp"
        android:src="@drawable/ic_back"
        app:tint="@color/text_muted" />
</GridLayout>
