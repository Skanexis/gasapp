<!--
  Цвет подписи кнопки.

  Недоступная кнопка приглушает текст, а не только фон: одна лишь
  смена заливки оставляет подпись читаемой, и кнопка выглядит
  нажимаемой, хотя не реагирует.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disabled" />
    <item android:color="#FFFFFFFF" />
</selector>
