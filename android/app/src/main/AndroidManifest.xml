<!--
  Атрибут package= убран: начиная с AGP 8 он игнорируется и вызывает
  предупреждение. Пакет задаётся через `namespace` в app/build.gradle.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Уведомления «есть новое» (ADR-040): разрешение на показ (Android 13+)
      и восстановление фоновой проверки после перезагрузки телефона
      (JobScheduler, setPersisted).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Камера — только для встроенного сканера QR (добавление контакта,
      сверка safety number). Запрашивается в момент сканирования; кадры
      разбираются на устройстве и никуда не уходят. Без камеры
      приложение работает: контакт добавляется по @имени.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Доступа к галерее и файлам в списке нет намеренно.

      🔐 Фото, видео и документы выбираются системным диалогом
      (ACTION_OPEN_DOCUMENT и Photo Picker). Он отдаёт приложению
      ровно тот файл, который человек указал, и ничего больше —
      в отличие от READ_MEDIA_IMAGES, который открывает всю галерею
      разом и навсегда.
    -->

    <application
        android:name=".GasAppApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GasApp"
        android:usesCleartextTraffic="false">
        <!--
          🔐 usesCleartextTraffic="false" — раздел 19.2, MASVS NETWORK-1.

          Запрет уже есть в network_security_config (base-config), и этот
          атрибут его дублирует. Дублирование намеренно: атрибут виден
          в манифесте распакованного APK, а конфигурация лежит отдельным
          ресурсом. Проверяющий — хоть аудитор, хоть Play Console —
          смотрит в манифест, и его молчание здесь читается как
          разрешение.

          Второй довод важнее косметического: конфигурацию легко потерять
          при слиянии манифестов из библиотеки, а атрибут при слиянии
          конфликтует громко.
        -->
        <!--
          Точка входа — экран блокировки, а не список чатов.

          Хранилище зашифровано, и до ввода PIN расшифровать нечего:
          любой другой стартовый экран показал бы пустой или, хуже,
          устаревший интерфейс до аутентификации.
        -->
        <activity
            android:name=".LockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Диагностический экран M1: версия ядра и проверка FFI. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <!--
          Фоновая проверка «есть ли новое». Запускает её только система:
          BIND_JOB_SERVICE держит лишь планировщик.
        -->
        <service
            android:name=".notify.NotifyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          Все экраны ниже android:exported="false".

          Экспортированная activity запускается любым приложением на
          устройстве: вредонос смог бы открыть чат по известному
          chat_id или подсунуть свой экран сверки safety number.
          Наружу смотрит только launcher-activity выше.
        -->
        <activity
            android:name=".ChatListActivity"
            android:exported="false" />

        <activity
            android:name=".ChatActivity"
            android:exported="false" />

        <activity
            android:name=".SafetyNumberActivity"
            android:exported="false" />


        <activity
            android:name=".SecurityCenterActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ContactsActivity"
            android:exported="false" />

        <!--
          Каналы. Не экспортируются: ссылку канала человек вставляет
          или сканирует внутри приложения — чужое приложение не может
          подсунуть её намерением.
        -->
        <activity
            android:name=".ChannelsActivity"
            android:exported="false" />

        <activity
            android:name=".ChannelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!--
          Не экспортируется. Прежде экран принимал ссылки gasapp://contact
          от любого приложения; ссылок в продукте больше нет — контакт
          добавляется по @имени или встроенным сканером QR, — и открытая
          дверь для чужих намерений убрана вместе с ними.
        -->
        <activity
            android:name=".AddContactActivity"
            android:exported="false" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ContactProfileActivity"
            android:exported="false" />

        <activity
            android:name=".PrivacyActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".AppearanceActivity"
            android:exported="false" />

        <activity
            android:name=".StorageActivity"
            android:exported="false" />

        <activity
            android:name=".DevicesActivity"
            android:exported="false" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />
        <!--
          Экраны резервного копирования и хранилища файлов (M6).

          🔐 `excludeFromRecents` у экранов ключа: карточка приложения
          в переключателе задач сохраняет заголовок экрана, а «Ключ
          восстановления» в списке недавних — уже подсказка тому, кто
          взял телефон в руки. Содержимое закрыто FLAG_SECURE, но сам
          факт лучше не показывать.
        -->
        <activity
            android:name=".RecoveryCenterActivity"
            android:exported="false" />

        <activity
            android:name=".RecoveryKeyActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".RecoveryConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".RestoreActivity"
            android:exported="false" />

        <activity
            android:name=".IdentityChangedActivity"
            android:exported="false" />

        <activity
            android:name=".VaultActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".NetworkActivity"
            android:exported="false" />

        <!-- FFI service bindings will be added here -->

    </application>

</manifest>
