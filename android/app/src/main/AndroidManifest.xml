<!--
  Атрибут package= убран: начиная с AGP 8 он игнорируется и вызывает
  предупреждение. Пакет задаётся через `namespace` в app/build.gradle.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Доступа к галерее и файлам в списке нет намеренно.
      
      🔐 Фото, видео и документы выбираются системным диалогом
      (ACTION_OPEN_DOCUMENT и Photo Picker). Он отдаёт приложению
      ровно тот файл, который человек указал, и ничего больше —
      в отличие от READ_MEDIA_IMAGES, который открывает всю галерею
      разом и навсегда.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AEGIS">
        <!--
          Точка входа — экран блокировки, а не список чатов.

          Хранилище зашифровано, и до ввода PIN расшифровать нечего:
          любой другой стартовый экран показал бы пустой или, хуже,
          устаревший интерфейс до аутентификации.
        -->
        <activity
            android:name=".LockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Диагностический экран M1: версия ядра и проверка FFI. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!--
          Все экраны ниже android:exported="false".

          Экспортированная activity запускается любым приложением на
          устройстве: вредонос смог бы открыть чат по известному
          chat_id или подсунуть свой экран сверки safety number.
          Наружу смотрит только launcher-activity выше.
        -->
        <activity
            android:name=".ChatListActivity"
            android:exported="false" />

        <activity
            android:name=".ChatActivity"
            android:exported="false" />

        <activity
            android:name=".SafetyNumberActivity"
            android:exported="false" />


        <activity
            android:name=".SecurityCenterActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ContactsActivity"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!--
          Единственный экспортированный экран кроме launcher.

          Экспорт обязателен: без него система не отдаст приложению
          ссылку aegis://, и обмен контактами по QR не заработает.

          🔐 Экран при этом безопасен по построению: он **только**
          подставляет ссылку в поле ввода и ждёт нажатия. Внешнее
          приложение не может ни добавить контакт, ни узнать что-либо
          о пользователе — ответа у намерения нет.

          launchMode=singleTop: вторая ссылка, открытая при уже
          запущенном экране, приходит в onNewIntent, а не заводит
          второй экземпляр поверх первого.
        -->
        <activity
            android:name=".AddContactActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aegis" android:host="contact" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ContactProfileActivity"
            android:exported="false" />
        <!-- FFI service bindings will be added here -->

    </application>

</manifest>