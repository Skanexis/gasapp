<!--
    Настройки lint.

    Здесь только то, что снято **осознанно**, с причиной. Всё
    остальное обязано оставаться включённым: `lintRelease` проходит
    без ошибок, и это то состояние, которое стоит удерживать.
-->
<lint>

    <!--
        Цифры клавиатуры PIN не локализуются.

        🔐 Это не упущение, а требование. PIN — последовательность
        ASCII-цифр: из неё выводится ключ базы через Argon2id, и байты
        входа обязаны быть одинаковыми на любом языке интерфейса.
        Локализованная «٣» вместо «3» дала бы другой ключ, то есть
        человек, сменивший язык системы, перестал бы открывать
        собственную переписку.

        Ограничено одним файлом: в остальных разметках зашитый текст
        по-прежнему ошибка.
    -->
    <issue id="HardcodedText">
        <ignore path="src/main/res/layout/activity_lock.xml" />
    </issue>

    <!--
        Диагностический экран M1 собирает строки конкатенацией.

        Он не показывается пользователю и будет удалён вместе
        с остальными следами M1; переводить его незачем.
    -->
    <issue id="SetTextI18n">
        <ignore path="src/main/kotlin/org/aegis/app/MainActivity.kt" />
    </issue>

    <!--
        `SharedPreferences.commit()` вместо `apply()` — намеренно.

        🔐 `apply()` пишет на диск асинхронно, и процесс, убитый сразу
        после неверной попытки PIN, унёс бы запись с собой. Перебор
        сводился бы к «ввести неверный PIN и снять приложение
        из недавних» (см. `core/PinAttempts.kt`).
    -->
    <issue id="ApplySharedPref">
        <ignore path="src/main/kotlin/org/aegis/app/core/PinAttempts.kt" />
    </issue>

</lint>
