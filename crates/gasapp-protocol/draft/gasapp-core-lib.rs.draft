/// Отметка контакта как верифицированного
#[uniffi::export]
pub fn mark_verified(core_state: &uniffi::RwLock<CoreState>, peer: AccountId, verified: bool) -> Result<(), GasAppError> {
    let mut state = core_state.write().unwrap();

    if verified {
        state.verified_contacts.write().unwrap().insert(peer);
    } else {
        state.verified_contacts.write().unwrap().remove(&peer);
    }

    Ok(())
}

