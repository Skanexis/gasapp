/// Установка таймера disappearing messages
#[uniffi::export]
pub fn set_disappearing_timer(core_state: &uniffi::RwLock<CoreState>, chat: ChatId, seconds: u32) -> Result<(), GasAppError> {
    let mut state = core_state.write().unwrap();

    // TODO: Реализовать установку таймера disappearing messages
    // Для прототипа просто сохраняем в состоянии чата
    let mut chat_state = state.get_chat_state(&chat).unwrap().unwrap_or_default();
    chat_state.disappearing_timer = Some(seconds);
    state.update_chat_state(&chat, chat_state)?;

    Ok(())
}

