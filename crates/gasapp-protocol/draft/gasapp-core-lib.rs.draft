/// Получение списка связанных устройств
#[uniffi::export]
pub fn linked_devices(core_state: &uniffi::RwLock<CoreState>) -> Result<Vec<LinkedDevice>, GasAppError> {
    let state = core_state.read().unwrap();

    // Преобразуем известные устройства в вектор LinkedDevice
    let known_devices = state.known_devices.read().unwrap();

    Ok(known_devices
        .iter()
        .map(|(device_id, name)| LinkedDevice {
            device_id: *device_id,
            name: name.clone(),
            is_current: false,  // TODO: Определить текущее устройство
            first_seen: Timestamp::from_millis(0),  // Placeholder
            last_seen: Timestamp::from_millis(0),   // Placeholder
        })
        .collect::<Vec<_>>()
    )
}

