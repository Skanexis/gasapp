//! Cryptographic protocol engine implementation for GasApp.
//!
//! Implements the ProtocolEngine trait by delegating to specific protocol implementations.
//! In M2, this implements a Triple Ratchet that combines:
//! 1. PQXDH for initial key exchange
//! 2. Double Ratchet (X25519 + HMAC-SHA-256) for forward secrecy
//! 3. SPQR (ML-KEM-768 + X25519 + HMAC-SHA-256) for post-quantum security

use gasapp_types::{GasAppError, Result, Secret, PublicKeyBytes};
use rand_core::{CryptoRng, RngCore};
use sha2::{Sha512, Digest};
use subtle::{Choice, ConstantTimeEq};
use zeroize::Zeroize;

use crate::{
    engine::{self, Clock, InitialMessage, InitiatedSession, ProtocolEngine},
    keys::{
        IdentityKey, IdentityKeyPair, KemPublicKey,
        PreKeyBundle, PreKeyId, SignedKemPreKey, SignedPreKey, SessionState,
    },
    mlkem1024::{MlKem1024PrivateKey, MlKem1024PublicKey},
    mlkem768::{MlKem768PrivateKey, MlKem768PublicKey},
    pqxdh::PqxdhEngine,
    double_ratchet::DoubleRatchetEngine,
    spqr::SpqrEngine,
    x25519::{X25519PrivateKey, X25519PublicKey},
    xeddsa::{XEdDSAPrivateKey, XEdDSAPublicKey},
    Fingerprint, ProtocolVersion, MAX_SKIPPED_MESSAGE_KEYS, MAX_SKIPPED_CHAINS,
};
use ml_kem::{DecapsulationKey1024, DecapsulationKey768, EncapsulationKey1024, EncapsulationKey768};
use gasapp_types::{Plaintext, Ciphertext};

// Constants from the specification
const ITERATIONS: u32 = 5200;
const FINGERPRINT_BYTES: usize = 30;

/// GasApp protocol engine implementation.
/// Implements the Triple Ratchet combining PQXDH, Double Ratchet, and SPQR.
#[derive(Clone, Zeroize)]
pub struct GasAppEngine {
    /// The underlying PQXDH protocol engine for initial key exchange
    pqxdh_engine: PqxdhEngine,
    /// The underlying Double Ratchet engine for synchronous communication
    double_ratchet_engine: DoubleRatchetEngine,
    /// The underlying SPQR engine for asynchronous post-quantum ratchet
    spqr_engine: SpqrEngine,
    /// Current active engine (starts with PQXDH, then switches to Double/SPQR)
    active_engine: ActiveEngine,
}

/// Which engine is currently active for protocol operations
#[derive(Clone, Copy, PartialEq, Eq)]
enum ActiveEngine {
    Pqxdh,    // Initial key exchange phase
    Double,   // Double Ratchet for synchronous messages
    Spqr,     // SPQR for asynchronous/post-quantum messages
    Hybrid,   // Combination of Double and SPQR
}

impl GasAppEngine {
    /// Creates a new GasAppEngine instance.
    pub fn new() -> Self {
        Self {
            pqxdh_engine: PqxdhEngine::new(),
            double_ratchet_engine: DoubleRatchetEngine::new(),
            spqr_engine: SpqrEngine::new(),
            active_engine: ActiveEngine::Pqxdh,
        }
    }

    /// Computes the iterative SHA-512 hash (5200 rounds) for fingerprint calculation.
    fn iterative_sha512(input: &[u8]) -> [u8; FINGERPRINT_BYTES] {
        let mut state = Sha512::new();
        state.update(input);
        let mut hash = state.finalize();

        // Apply 5199 more iterations (we already did 1 above)
        for _ in 1..ITERATIONS {
            let mut state = Sha512::new();
            state.update(hash);
            hash = state.finalize();
        }

        // Take the first 30 bytes for the fingerprint
        let mut result = [0u8; FINGERPRINT_BYTES];
        result.copy_from_slice(&hash[..FINGERPRINT_BYTES]);
        result
    }
}

impl Default for GasAppEngine {
    fn default() -> Self {
        Self::new()
    }
}

impl ProtocolEngine for GasAppEngine {
    fn initiate_session(
        &self,
        our_identity: &IdentityKeyPair,
        their_bundle: &PreKeyBundle,
        rng: &mut dyn CryptoRng,
    ) -> Result<InitiatedSession> {
        // Start with PQXDH for initial key exchange
        self.pqxdh_engine.initiate_session(our_identity, their_bundle, rng)
    }

    fn accept_session(
        &self,
        our_identity: &IdentityKeyPair,
        message: &InitialMessage,
    ) -> Result<(SessionState, PublicKeyBytes)> {
        // Start with PQXDH for initial key exchange
        self.pqxdh_engine.accept_session(our_identity, message)
    }

    fn encrypt(&self, session: &mut SessionState, plaintext: &Plaintext) -> Result<Ciphertext> {
        // Delegate to the appropriate engine based on current state
        match self.active_engine {
            ActiveEngine::Pqxdh => {
                // Still in initial key exchange phase
                self.pqxdh_engine.encrypt(session, plaintext)
            }
            ActiveEngine::Double => {
                // Using Double Ratchet
                self.double_ratchet_engine.encrypt(session, plaintext)
            }
            ActiveEngine::Spqr => {
                // Using SPQR
                self.spqr_engine.encrypt(session, plaintext)
            }
            ActiveEngine::Hybrid => {
                // Using hybrid approach - for now, default to Double Ratchet
                self.double_ratchet_engine.encrypt(session, plaintext)
            }
        }
    }

    fn decrypt(&self, session: &mut SessionState, ciphertext: &Ciphertext) -> Result<Plaintext> {
        // Delegate to the appropriate engine based on current state
        match self.active_engine {
            ActiveEngine::Pqxdh => {
                // Still in initial key exchange phase
                self.pqxdh_engine.decrypt(session, ciphertext)
            }
            ActiveEngine::Double => {
                // Using Double Ratchet
                self.double_ratchet_engine.decrypt(session, ciphertext)
            }
            ActiveEngine::Spqr => {
                // Using SPQR
                self.spqr_engine.decrypt(session, ciphertext)
            }
            ActiveEngine::Hybrid => {
                // Using hybrid approach - for now, default to Double Ratchet
                self.double_ratchet_engine.decrypt(session, ciphertext)
            }
        }
    }

    fn fingerprint(
        &self,
        identity: &IdentityKey,
        identifier: &[u8],
    ) -> Result<Fingerprint> {
        // Combine the identity key bytes with the identifier
        let mut input = Vec::new();
        input.extend_from_slice(identity.public().as_ref());
        input.extend_from_slice(identifier);

        // Compute iterative SHA-512 (5200 rounds)
        let fingerprint_bytes = Self::iterative_sha512(&input);

        Ok(Fingerprint::from_bytes(fingerprint_bytes))
    }

    fn version(&self) -> ProtocolVersion {
        ProtocolVersion::CURRENT
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use rand_core::OsRng;

    #[test]
    fn test_iterative_sha512() {
        let engine = GasAppEngine::new();
        let input = b"test input";
        let hash1 = engine.iterative_sha512(input);
        let hash2 = engine.iterative_sha512(input);

        // Same input should produce same output
        assert_eq!(hash1, hash2);

        // Different input should produce different output (with very high probability)
        let hash3 = engine.iterative_sha512(b"different input");
        assert_ne!(hash1, hash3);
    }

    #[test]
    fn test_fingerprint() {
        let engine = GasAppEngine::new();
        let identity_key = IdentityKey::new([1u8; 32]);
        let identifier = b"test identifier";

        let fingerprint = engine.fingerprint(&identity_key, identifier).unwrap();
        let fingerprint2 = engine.fingerprint(&identity_key, identifier).unwrap();

        // Same input should produce same fingerprint
        assert_eq!(fingerprint, fingerprint2);

        // Different identifier should produce different fingerprint
        let fingerprint3 = engine.fingerprint(&identity_key, b"different").unwrap();
        assert_ne!(fingerprint, fingerprint3);
    }
}