# SPDX-License-Identifier: AGPL-3.0-only
#
# Настройки развёртывания — ОДИН файл на весь кластер.
#
#   cp bundle.conf.example bundle.conf      # заполнить своими значениями
#   ./prepare-bundle.sh bundle.conf          # → каталог bundle/
#
# Секретов здесь нет: только домены и адреса. Файл можно хранить где
# угодно, но в git его не кладите — адреса машин незачем раздавать.
#
# Внутренние адреса — те, что машины получили в ЧАСТНОЙ сети хостера
# (не публичные!). Посмотреть на машине: ip -4 addr

# Домен сервера сообщений — его вписывают в сборку приложения.
DOMAIN=api.gasapp.chat

# Домен сайта с документами (политика, условия, удаление аккаунта).
SITE_DOMAIN=gasapp.chat

# Почта для Let's Encrypt (предупреждения о сроках сертификатов).
ACME_EMAIL=ops@gasapp.chat

# Обратный адрес писем с кодом подтверждения.
MAIL_FROM=no-reply@gasapp.chat

# Частная сеть хостера целиком (адрес/маска).
NET=10.0.0.0/24

# VPS-1: балансировщик и первый узел API.
LB=10.0.0.2

# Узлы API через пробел. ПЕРВЫЙ — тот же адрес, что LB.
# Два сервера на старте — один узел: NODES="10.0.0.2".
NODES="10.0.0.2 10.0.0.3 10.0.0.4"

# Сервер базы (и админ-центра, и резервных копий).
DB=10.0.0.5

# Срок набора пинов в сборке приложения (expiration в
# android/app/src/release/res/xml/network_security_config.xml):
# не раньше чем через 12 месяцев от выпуска.
PIN_EXPIRATION=2027-12-01
