# Сайт-обложка и туннель по секретному пути.

{
	email {$EMAIL}
}

{$DOMAIN} {
	# Туннель — только по секретному пути, путь не обрезается:
	# сервер WebTunnel сверяет его сам.
	handle /{$WT_PATH}* {
		reverse_proxy webtunnel:15000
	}

	# Остальное — обычная статическая страница: снаружи это сайт.
	handle {
		root * /srv
		file_server
	}

	# Журнал доступа выключен: адреса клиентов моста не пишутся.
	log {
		output discard
	}
}
