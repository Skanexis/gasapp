# SPDX-License-Identifier: AGPL-3.0-only
#
# /etc/aegis/monitor.env — настройка aegis-monitor.sh (права 644:
# секретов здесь нет; токен Telegram — в /etc/aegis/credentials/telegram).
#
# Без кавычек вокруг списков нельзя: файл читают и systemd, и bash.

# Роль машины: lb, node, db, admin (через пробел).
AEGIS_ROLES="lb"

# Службы, которые обязаны работать.
#   lb:    "nginx aegis-onion-docker" (или docker, если onion в контейнере)
#   node:  "aegis-server"
#   db:    "postgresql aegis-admin"
AEGIS_UNITS="nginx"

# Порты, которые МОЖНО слушать не на петле (остальные — тревога).
#   lb:    "22 80 443 8444"
#   node:  "22 8443"
#   db:    "22 5432"
AEGIS_ALLOWED_PORTS="22 80 443 8444"

# Порог заполнения диска, %.
AEGIS_DISK_MAX=85

# Внутренние сертификаты, срок которых отслеживать.
#   node:  "/etc/aegis/tls/node.pem"
#   db:    "/etc/postgresql/aegis-tls/db.pem"
AEGIS_WATCH_CERTS=""

# Суммы исполняемых файлов (sha256sum ... > /etc/aegis/checksums.sha256).
AEGIS_CHECKSUMS=/etc/aegis/checksums.sha256

# --- только lb -----------------------------------------------------------
AEGIS_DOMAIN=aegis.example.com
# Пины приложения (те же, что в сборке).
AEGIS_PINS_FILE=/etc/aegis/pins.txt
# `expiration` из pin-set приложения (network_security_config.xml).
AEGIS_PIN_EXPIRATION=2027-01-01
# Узлы API для check-nodes.sh.
AEGIS_NODES="10.0.0.1 10.0.0.2 10.0.0.3"
AEGIS_HEALTH_PORT=8443
AEGIS_INTERNAL_CA=/etc/aegis/pki/ca.pem

# --- на машине базы: проверка публичного входа снаружи балансировщика ----
# Если умрёт сам балансировщик, его монитор замолчит; этот — нет.
#AEGIS_PROBE_PUBLIC=aegis.example.com:443

# Час (UTC) ежедневного «монитор жив».
AEGIS_HEARTBEAT_HOUR=09
