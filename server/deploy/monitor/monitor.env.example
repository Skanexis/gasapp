# SPDX-License-Identifier: AGPL-3.0-only
#
# /etc/gasapp/monitor.env — настройка gasapp-monitor.sh (права 644:
# секретов здесь нет; токен Telegram — в /etc/gasapp/credentials/telegram).
#
# Без кавычек вокруг списков нельзя: файл читают и systemd, и bash.

# Роль машины: lb, node, db, admin (через пробел).
GASAPP_ROLES="lb"

# Службы, которые обязаны работать.
#   lb:    "nginx gasapp-onion-docker" (или docker, если onion в контейнере)
#   node:  "gasapp-server"
#   db:    "postgresql gasapp-admin"
GASAPP_UNITS="nginx"

# Порты, которые МОЖНО слушать не на петле (остальные — тревога).
#   lb:    "22 80 443 8444"
#   node:  "22 8443"
#   db:    "22 5432"
#   IONOS DHCP client: add "68/udp" after confirming its owner with
#   sudo ss -Hlunp 'sport = :68' (this does not change firewall rules).
GASAPP_ALLOWED_PORTS="22 80 443 8444"

# Порог заполнения диска, %.
GASAPP_DISK_MAX=85

# Внутренние сертификаты, срок которых отслеживать.
#   node:  "/etc/gasapp/tls/node.pem"
#   db:    "/etc/postgresql/gasapp-tls/db.pem"
GASAPP_WATCH_CERTS=""

# Суммы исполняемых файлов (sha256sum ... > /etc/gasapp/checksums.sha256).
GASAPP_CHECKSUMS=/etc/gasapp/checksums.sha256

# --- только lb -----------------------------------------------------------
GASAPP_DOMAIN=gasapp.example.com
# Пины приложения (те же, что в сборке).
GASAPP_PINS_FILE=/etc/gasapp/pins.txt
# `expiration` из pin-set приложения (network_security_config.xml).
GASAPP_PIN_EXPIRATION=2027-01-01
# Узлы API для check-nodes.sh.
GASAPP_NODES="10.0.0.1 10.0.0.2 10.0.0.3"
GASAPP_HEALTH_PORT=8443
GASAPP_INTERNAL_CA=/etc/gasapp/pki/ca.pem

# --- на машине базы: проверка публичного входа снаружи балансировщика ----
# Если умрёт сам балансировщик, его монитор замолчит; этот — нет.
#GASAPP_PROBE_PUBLIC=gasapp.example.com:443

# --- Дополнительные сайты на этой машине (например, GAS на поддомене) ----
# домен=адрес проверки на петле; пин не проверяется (обычный certbot).
# Заполняет сам установщик GAS (scripts/install.sh --behind-nginx);
# тогда в GASAPP_UNITS добавляется и "docker".
#GASAPP_EXTRA_SITES="shop.gasapp.eu=http://127.0.0.1:8790/api/stores"
# Отметки об успешной копии этих сайтов (тревога, если старше 26 часов).
#GASAPP_EXTRA_BACKUPS="/opt/gas/backups/last-success"

# Час (UTC) ежедневного «монитор жив».
GASAPP_HEARTBEAT_HOUR=09
