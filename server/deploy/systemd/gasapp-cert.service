#
# Продление публичного сертификата балансировщика: /opt/gasapp/certbot/gasapp-cert.sh
# Ключ свой и не меняется; certbot только подписывает запрос, а nginx
# получает сертификат, лишь если ключ — из набора пинов (/etc/gasapp/pins.txt).
#
# Таймер certbot из пакета (certbot.timer) продлевает цепочки certbot
# с НОВЫМ ключом. У сервера сообщений цепочки certbot нет (certonly --csr),
# поэтому его ключа таймер не касается. Цепочка есть только у сайта
# документов (nginx/site.conf) — его ключ не пинится, и certbot.timer
# нужен именно для него: не выключать, если сайт на этой машине.
# ⚠️ Не выпускать сертификат сервера сообщений обычным `certbot certonly -d`:
# появится цепочка, и путаница, какой файл настоящий, гарантирована.

[Unit]
Description=GasApp: renew public TLS certificate (pinned key)
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/gasapp/certbot/gasapp-cert.sh renew
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
LimitCORE=0
UMask=0077
