#
# Монитор хоста GasApp: /opt/gasapp/monitor/gasapp-monitor.sh раз в две
# минуты (gasapp-monitor.timer). Роль хоста и пороги —
# в /etc/gasapp/monitor.env.
#
# Свой пользователь без прав (gasapp-monitor, создаёт harden-host.sh),
# чтение журнала — через группу systemd-journal. Монитор только смотрит:
# ему не нужно ни писать в систему, ни чинить её. Оповещения — через
# notify-telegram.sh.
#
# ⚠️ Не DynamicUser: dbus-daemon не узнаёт динамического пользователя
# без libnss-systemd, которого нет в минимальных образах, — и
# `systemctl is-active` в мониторе молча отвечал бы «не работает»
# про живые службы. Проверено на стенде.

[Unit]
Description=GasApp: host and service monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gasapp-monitor
Group=gasapp-monitor
SupplementaryGroups=systemd-journal
StateDirectory=gasapp-monitor
StateDirectoryMode=0700
EnvironmentFile=/etc/gasapp/monitor.env
Environment=GASAPP_MONITOR_STATE=%S/gasapp-monitor
Environment=GASAPP_NOTIFY_CMD=/opt/gasapp/notify-telegram.sh
LoadCredential=telegram:/etc/gasapp/credentials/telegram
ExecStart=/opt/gasapp/monitor/gasapp-monitor.sh
TimeoutStartSec=90

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitCORE=0
