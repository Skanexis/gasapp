#
# Миграции схемы и права ролей: /etc/systemd/system/gasapp-migrate.service
# Ставится на машину базы (VPS-4) рядом с админ-центром.
#
# 🔐 Аудит 2026-11-28, S-10: службы работают под своими ролями без права
# менять схему (deploy/postgres/roles.sql). Схему меняет только этот
# шаг — под владельцем `gasapp`, с этой машины (сокет). Права ролей
# раздаются тем же проходом, так что таблицы новых миграций получают их
# сразу. Админ-центр зовёт его перед собой; перед обновлением узлов:
#
#     sudo systemctl start gasapp-migrate
#
# и только потом новые программы на узлы (docs/ops/db-roles.md).

[Unit]
Description=GasApp database migrations and role grants
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=gasapp-admin
Group=gasapp-admin
ExecStart=/usr/local/bin/gasapp-server-admin migrate
Environment=NO_COLOR=1
# Пароль владельца схемы — только здесь.
LoadCredential=database_url:/etc/gasapp/credentials/owner_database_url

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoExecPaths=/
ExecPaths=/usr/local/bin/gasapp-server-admin /usr/lib /lib /lib64 /usr/lib64
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

# Unix-сокет базы и петля — больше ничего.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

LimitCORE=0
TasksMax=256

[Install]
WantedBy=multi-user.target
