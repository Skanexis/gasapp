# ============================================================================
#  БЕЗОПАСНОСТЬ — эти правила идут ПЕРВЫМИ и не должны ослабляться
# ============================================================================
# Ничто из перечисленного не должно попасть в репозиторий даже случайно.
*.key
*.pem
# Единственное исключение: публичные корневые сертификаты аттестации
# Google — открытые данные, без которых KeyAttestationTest не сверит
# суммы корней в коде. Закрытого ключа в файле нет и быть не может.
!android/app/src/test/resources/google_attestation_roots.pem
*.p12
*.p8
*.keystore
*.jks
*.mobileprovision
*.cer
secrets.*
.env
.env.*
!.env.example
*recovery-key*
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
# Дампы памяти и крашей могут содержать ключевой материал
*.dmp
*.core
crash-*

# ⚠️ Дамп ядра — `core` или `core.<pid>`, и правило привязано к корню.
#
# Здесь стояло `core.*`, и на Windows оно молча съедало
# `android/app/src/main/kotlin/org/gasapp/app/core/Core.kt`: git
# на NTFS сравнивает пути без учёта регистра (`core.ignorecase=true`),
# и `core.*` совпало с `Core.kt`.
#
# Файл не попадал в репозиторий **ни разу за всю историю проекта** —
# при том что это единственное место, где собирается ключ базы
# (находка P-5, раздел 23.6, жила только на машине разработчика).
# Ни компилятор, ни тесты этого не видели: локально файл на месте,
# а `git status` про игнорируемое молчит по определению.
/core
/core.[0-9]*

# ============================================================================
#  Rust
# ============================================================================
/target/
**/target/
Cargo.lock.bak
*.toml.backup
# ВНИМАНИЕ: Cargo.lock НЕ игнорируется — он обязателен для reproducible builds

# Отладочные артефакты в корне репозитория.
#
# В сессии 6 из корня было удалено ~1.9 ГБ временных крейтов (`debug_test*/`,
# `verify_x25519*/`, `rfc_test*/` и др.), созданных при ручной отладке X25519,
# вместе со скомпилированными `.exe`/`.pdb`. Правила ниже не дают им вернуться:
# отладка ведётся тестами внутри крейта, а не одноразовыми проектами в корне.
/debug_*/
/test_*/
/check_*/
/verify_*/
/rfc_*/
/*_test/
/*.exe
/*.pdb

# fuzz
fuzz/target/
fuzz/artifacts/
fuzz/coverage/

# ============================================================================
#  iOS
# ============================================================================
ios/build/
ios/DerivedData/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
ios/Generated/
*.xcframework/
Pods/

# ============================================================================
#  Android
# ============================================================================
android/build/
android/**/build/
android/.gradle/
android/local.properties
android/**/src/main/jniLibs/
android/app/release/
android/generated/
*.apk
*.aab
*.aar

# ============================================================================
#  Прочее
# ============================================================================
node_modules/
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
!.vscode/extensions.json

# Приватные ключи TLS.
#
# 🔐 Ключ сервера в репозитории означал бы, что любой, кто клонировал
# проект, может выдать себя за сервер. Сертификат (публичная часть)
# коммитится — по нему клиент строит пин.
server/deploy/tls/key.pem

# Снимки проверок дизайна (impeccable): рабочие, не исходники.
.impeccable/review/
.impeccable/config.local.json
