# ============================================================================
#  БЕЗОПАСНОСТЬ — эти правила идут ПЕРВЫМИ и не должны ослабляться
# ============================================================================
# Ничто из перечисленного не должно попасть в репозиторий даже случайно.
*.key
*.pem
*.p12
*.p8
*.keystore
*.jks
*.mobileprovision
*.cer
secrets.*
.env
.env.*
!.env.example
*recovery-key*
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
# Дампы памяти и крашей могут содержать ключевой материал
*.dmp
*.core
core.*
crash-*

# ============================================================================
#  Rust
# ============================================================================
/target/
**/target/
Cargo.lock.bak
*.toml.backup
# ВНИМАНИЕ: Cargo.lock НЕ игнорируется — он обязателен для reproducible builds

# Отладочные артефакты в корне репозитория.
#
# В сессии 6 из корня было удалено ~1.9 ГБ временных крейтов (`debug_test*/`,
# `verify_x25519*/`, `rfc_test*/` и др.), созданных при ручной отладке X25519,
# вместе со скомпилированными `.exe`/`.pdb`. Правила ниже не дают им вернуться:
# отладка ведётся тестами внутри крейта, а не одноразовыми проектами в корне.
/debug_*/
/test_*/
/check_*/
/verify_*/
/rfc_*/
/*_test/
/*.exe
/*.pdb

# fuzz
fuzz/target/
fuzz/artifacts/
fuzz/coverage/

# ============================================================================
#  iOS
# ============================================================================
ios/build/
ios/DerivedData/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
ios/Generated/
*.xcframework/
Pods/

# ============================================================================
#  Android
# ============================================================================
android/build/
android/**/build/
android/.gradle/
android/local.properties
android/**/src/main/jniLibs/
android/app/release/
android/generated/
*.apk
*.aab
*.aar

# ============================================================================
#  Прочее
# ============================================================================
node_modules/
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
!.vscode/extensions.json

# Приватные ключи TLS.
#
# 🔐 Ключ сервера в репозитории означал бы, что любой, кто клонировал
# проект, может выдать себя за сервер. Сертификат (публичная часть)
# коммитится — по нему клиент строит пин.
server/deploy/tls/key.pem
