<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 🔐 Файлы приложения недоступны, пока телефон заблокирован
	     (Data Protection: класс Complete). База и соль — тоже. -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<!-- Пустые пуш-уведомления (App/Push.swift). «development» — для
	     сборки из Xcode; при выгрузке в TestFlight/App Store Xcode сам
	     ставит «production». -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
