<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Тёмная тема всегда: приложение рисуется только тёмным, и системные
	     элементы (заголовки, клавиатура, листы) не должны быть светлыми. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GasApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Ссылки на контакт: схема gasapp://contact/… — для кнопки «Открыть
	     в GasApp» на странице https://gasapp.eu/add/. Ссылка только
	     открывает вопрос «Добавить контакт?» (ChatListScreen). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.gasapp.messenger.contact</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gasapp</string>
			</array>
		</dict>
	</array>
	<!-- Камера — только для сканирования QR контакта и safety number. -->
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan a contact’s QR code or a safety number. Camera images are not sent anywhere.</string>
	<!-- Face ID — только чтобы открыть переписку вместо PIN (по желанию). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks your messages instead of the PIN. Turn it on in Settings.</string>
	<!-- Фото — только то, что вы выбрали для отправки. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To send the photo you choose. Metadata (location, device) is removed before sending.</string>
	<!-- Настройки сборки (ios/Config/*.xcconfig) — читает AppConfig.swift. -->
	<!-- Экспорт шифрования (docs/store/app-store.md, раздел 2): ключа
	     ITSAppUsesNonExemptEncryption здесь НЕТ намеренно. С YES и без кода
	     документа Apple отклоняет загрузку (ITMS-90592, 2026-11-12); без
	     ключа ответы даются в App Store Connect → TestFlight → «Missing
	     Compliance». Код появится, только если Apple выдаст документ. -->
	<key>GASAPPServerURL</key>
	<string>$(GASAPP_SERVER_URL)</string>
	<key>GASAPPServerOnion</key>
	<string>$(GASAPP_SERVER_ONION)</string>
	<key>GASAPPDocsURL</key>
	<string>$(GASAPP_DOCS_URL)</string>
	<key>GASAPPPins</key>
	<string>$(GASAPP_PINS)</string>
	<key>GASAPPPinExpiration</key>
	<string>$(GASAPP_PIN_EXPIRATION)</string>
</dict>
</plist>
